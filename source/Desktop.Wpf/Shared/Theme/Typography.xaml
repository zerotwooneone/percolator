<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <FontFamily x:Key="AppFont">Segoe UI</FontFamily>
  <sys:Double x:Key="FontSizeBase">14</sys:Double>
  <sys:Double x:Key="FontSizeTitle">20</sys:Double>
  <Style x:Key="BaseTextBlock" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
    <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}"/>
    <Setter Property="FontSize" Value="{StaticResource FontSizeBase}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlock}" />

  <!-- Title/Text variants inspired by mockup -->
  <Style x:Key="TitleText" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlock}">
    <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
</ResourceDictionary>
