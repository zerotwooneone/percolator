<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Material-inspired role tokens (Dark theme) -->
  <Color x:Key="ColorPrimary">#2EC7FF</Color>
  <Color x:Key="ColorOnPrimary">#FFFFFF</Color>

  <Color x:Key="ColorSurface">#121826</Color>
  <Color x:Key="ColorOnSurface">#E6FFFFFF</Color>
  <Color x:Key="ColorSurfaceVariant">#1B2333</Color>
  <Color x:Key="ColorOnSurfaceVariant">#99FFFFFF</Color>

  <Color x:Key="ColorOutline">#3C5E8A</Color>
  <Color x:Key="ColorOutlineVariant">#32435E</Color>

  <Color x:Key="ColorSurfaceContainerLow">#0F1522</Color>
  <Color x:Key="ColorSurfaceContainer">#172134</Color>
  <Color x:Key="ColorSurfaceContainerHigh">#233044</Color>

  <Color x:Key="ColorSuccess">#29D391</Color>
  <Color x:Key="ColorError">#F44336</Color>

  <!-- Derived brushes -->
  <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource ColorPrimary}"/>
  <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource ColorOnPrimary}"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource ColorSurface}"/>
  <SolidColorBrush x:Key="OnSurfaceBrush" Color="{StaticResource ColorOnSurface}"/>
  <SolidColorBrush x:Key="SurfaceVariantBrush" Color="{StaticResource ColorSurfaceVariant}"/>
  <SolidColorBrush x:Key="OnSurfaceVariantBrush" Color="{StaticResource ColorOnSurfaceVariant}"/>
  <SolidColorBrush x:Key="OutlineBrush" Color="{StaticResource ColorOutline}"/>
  <SolidColorBrush x:Key="OutlineVariantBrush" Color="{StaticResource ColorOutlineVariant}"/>
  <SolidColorBrush x:Key="SurfaceContainerLowBrush" Color="{StaticResource ColorSurfaceContainerLow}"/>
  <SolidColorBrush x:Key="SurfaceContainerBrush" Color="{StaticResource ColorSurfaceContainer}"/>
  <SolidColorBrush x:Key="SurfaceContainerHighBrush" Color="{StaticResource ColorSurfaceContainerHigh}"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource ColorSuccess}"/>
  <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ColorError}"/>
  <!-- State brushes -->
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#1D2A44"/>
  <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="#233044"/>

  <!-- Component aliases (for clarity) -->
  <!-- Inputs -->
  <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource ColorSurfaceVariant}"/>
  <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource ColorOutline}"/>

  <!-- Cards / containers -->
  <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource ColorSurfaceContainer}"/>
  <SolidColorBrush x:Key="ChipBackgroundBrush" Color="#1A2740"/>

  <!-- Buttons -->
  <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{StaticResource ColorSurfaceContainerHigh}"/>
  <SolidColorBrush x:Key="ButtonHoverBrush" Color="#1D2A44"/>

  <!-- Slide toggle brushes derive from roles -->
  <SolidColorBrush x:Key="SlideToggleTrackOffBrush" Color="{StaticResource ColorSurfaceVariant}"/>
  <SolidColorBrush x:Key="SlideToggleTrackOnBrush" Color="{StaticResource ColorPrimary}"/>
  <SolidColorBrush x:Key="SlideToggleKnobOffBrush" Color="{StaticResource ColorOnSurface}"/>
  <SolidColorBrush x:Key="SlideToggleKnobOnBrush" Color="{StaticResource ColorOnPrimary}"/>

  <!-- Presence -->
  <SolidColorBrush x:Key="PresenceOnlineBrush" Color="{StaticResource ColorSuccess}"/>

</ResourceDictionary>
