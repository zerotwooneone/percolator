<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">
  <!-- Base icon style: uses detected IconFontFamily -->
  <Style x:Key="IconText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource IconFontFamily}"/>
    <Setter Property="Foreground" Value="{StaticResource OnSurfaceBrush}"/>
    <Setter Property="FontSize" Value="24"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="IconTextSmall" TargetType="TextBlock" BasedOn="{StaticResource IconText}">
    <Setter Property="FontSize" Value="14"/>
  </Style>

  <!-- Glyphs as strings (NerdFont codepoints) -->
  <system:String x:Key="IconSearch">&#xF002;</system:String>
  <system:String x:Key="IconPencil">&#xEA73;</system:String>
  <system:String x:Key="IconShield">&#xEB53;</system:String>
  <system:String x:Key="IconLock">&#xEA75;</system:String>
  <system:String x:Key="IconPhone">&#xF095;</system:String>
  <system:String x:Key="IconVideo">&#xF03D;</system:String>
  <system:String x:Key="IconKebab">&#xEB10;</system:String>
  <system:String x:Key="IconCheck">&#xEAB2;</system:String>
  <system:String x:Key="IconDoubleCheck">&#xEBB1;</system:String>
  <system:String x:Key="IconPlus">&#xF067;</system:String>
  <system:String x:Key="IconSmiley">&#xEB54;</system:String>
  <system:String x:Key="IconClip">&#xF0C6;</system:String>
  <system:String x:Key="IconSend">&#xF1D9;</system:String>
  <!-- Network menu icons -->
  <system:String x:Key="IconNetwork">&#xEF09;</system:String>
  <system:String x:Key="IconLatency">&#xF0128;</system:String>
  <system:String x:Key="IconRefresh">&#xF021;</system:String>
  <system:String x:Key="IconCopy">&#xF0C5;</system:String>
  <system:String x:Key="IconWrench">&#xF0AD;</system:String>
  <system:String x:Key="IconMapMarker">&#xF034E;</system:String>
  <system:String x:Key="IconTreeGraph">&#xF104A;</system:String>
  <system:String x:Key="IconCloudLock">&#xF11F1;</system:String>
  <system:String x:Key="IconRelay">&#xF50F;</system:String>
</ResourceDictionary>
