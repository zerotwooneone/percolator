<UserControl x:Class="Desktop.Wpf.Shared.Controls.MatSlideToggle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Width="42" Height="24">
  <Grid>
    <ToggleButton x:Name="PART_Toggle"
                  IsChecked="{Binding IsChecked, ElementName=Root, Mode=TwoWay}"
                  Background="Transparent"
                  BorderThickness="0"
                  FocusVisualStyle="{x:Null}">
      <ToggleButton.Template>
        <ControlTemplate TargetType="ToggleButton">
          <Grid Width="42" Height="24">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="Track"
                    Grid.ColumnSpan="2"
                    CornerRadius="12"
                    Background="{DynamicResource SlideToggleTrackOffBrush}"
                    SnapsToDevicePixels="True"/>
            <!-- Inner field provides 3px padding on both sides and clips the knob -->
            <Grid x:Name="Field" Grid.ColumnSpan="2" Margin="3" ClipToBounds="True">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="18"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="Knob"
                      Grid.Column="0"
                      Width="18" Height="18" CornerRadius="9"
                      Background="{DynamicResource SlideToggleKnobOffBrush}"/>
            </Grid>
            <!-- Optional content: Off/On labels -->
            <Grid IsHitTestVisible="False">
              <ContentPresenter x:Name="OffContentPresenter"
                                Content="{Binding OffContent, ElementName=Root}"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                Opacity="0.8"/>
              <ContentPresenter x:Name="OnContentPresenter"
                                Content="{Binding OnContent, ElementName=Root}"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                Opacity="0.95" Visibility="Collapsed"/>
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Border.Background" Value="{DynamicResource SlideToggleTrackOnBrush}"/>
              <Setter TargetName="Knob" Property="Border.Background" Value="{DynamicResource SlideToggleKnobOnBrush}"/>
              <Setter TargetName="Knob" Property="Grid.Column" Value="1"/>
              <Setter TargetName="OnContentPresenter" Property="UIElement.Visibility" Value="Visible"/>
              <Setter TargetName="OffContentPresenter" Property="UIElement.Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="False">
              <Setter TargetName="Track" Property="Border.Background" Value="{DynamicResource SlideToggleTrackOffBrush}"/>
              <Setter TargetName="Knob" Property="Border.Background" Value="{DynamicResource SlideToggleKnobOffBrush}"/>
              <Setter TargetName="Knob" Property="Grid.Column" Value="0"/>
              <Setter TargetName="OnContentPresenter" Property="UIElement.Visibility" Value="Collapsed"/>
              <Setter TargetName="OffContentPresenter" Property="UIElement.Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Track" Property="Opacity" Value="0.4"/>
              <Setter TargetName="Knob" Property="Opacity" Value="0.6"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </ToggleButton.Template>
    </ToggleButton>
  </Grid>
</UserControl>
