<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Desktop.Wpf.Shared.Controls"
                    xmlns:att="clr-namespace:Desktop.Wpf.Shared.Attached">
  <DataTemplate x:Key="PendingHandshakeItemTemplate">
    <Border Style="{StaticResource BaseBorder}" Margin="0,10,0,0" Padding="8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <controls:InitialsAvatar Diameter="32" Text="{Binding Initials}"/>
        <StackPanel Grid.Column="1" Margin="10,0,0,0">
          <TextBlock Text="{Binding DisplayName}"/>
          <TextBlock Text="{Binding BundleText}" Foreground="{StaticResource OnSurfaceVariantBrush}" FontSize="12"/>
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <controls:MatButton Grid.Column="0" Variant="Outlined" Height="28"
                                Command="{Binding DataContext.AcceptHandshakeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                CommandParameter="{Binding}"
                                att:MenuBehaviors.CloseParentOnClick="True">
              <TextBlock Text="ACCEPT"/>
            </controls:MatButton>
            <controls:MatButton Grid.Column="1" Margin="10,0,0,0" Variant="Outlined" Height="28"
                                Command="{Binding DataContext.BurnHandshakeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                CommandParameter="{Binding}"
                                att:MenuBehaviors.CloseParentOnClick="True">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="🔥" Margin="0,0,6,0"/>
                <TextBlock Text="BURN"/>
              </StackPanel>
            </controls:MatButton>
          </Grid>
        </StackPanel>
      </Grid>
    </Border>
  </DataTemplate>

  <DataTemplate x:Key="PendingHandshakesCard">
    <Border Style="{StaticResource BaseBorder}" Padding="12" Width="260">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="PENDING HANDSHAKES" Foreground="{StaticResource OnSurfaceVariantBrush}" FontSize="12"/>
          <TextBlock Grid.Column="1" Text="✕" Opacity="0.6"/>
        </Grid>
        <ItemsControl ItemsSource="{Binding PendingHandshakes}" ItemTemplate="{StaticResource PendingHandshakeItemTemplate}"/>
      </StackPanel>
    </Border>
  </DataTemplate>
</ResourceDictionary>
