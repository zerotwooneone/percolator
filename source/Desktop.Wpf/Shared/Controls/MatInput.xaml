<UserControl x:Class="Desktop.Wpf.Shared.Controls.MatInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:att="clr-namespace:Desktop.Wpf.Shared.Attached">
  <Border Background="{StaticResource InputBackgroundBrush}"
          BorderBrush="{StaticResource InputBorderBrush}"
          BorderThickness="1" CornerRadius="8" Padding="8">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <!-- Prefix slot -->
      <ContentPresenter Grid.Column="0"
                        VerticalAlignment="Center"
                        Content="{Binding Prefix, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

      <!-- Input -->
      <TextBox Grid.Column="1"
               Background="Transparent"
               BorderThickness="0"
               Foreground="{StaticResource ForegroundBrush}"
               att:Placeholder.Text="{Binding Placeholder, RelativeSource={RelativeSource AncestorType=UserControl}}"
               Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

      <!-- Suffix slot -->
      <ContentPresenter Grid.Column="2"
                        VerticalAlignment="Center"
                        Content="{Binding Suffix, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
    </Grid>
  </Border>
</UserControl>
