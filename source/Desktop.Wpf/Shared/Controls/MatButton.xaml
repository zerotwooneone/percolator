<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Desktop.Wpf.Shared.Controls">
  <Style TargetType="controls:MatButton" BasedOn="{StaticResource MatButtonBase}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="controls:MatButton">
          <Border x:Name="Bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding controls:MatButton.CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource ButtonHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
            </Trigger>
            <!-- Icon sizing -->
            <Trigger Property="controls:MatButton.IsIcon" Value="True">
              <Setter Property="Width" Value="40"/>
              <Setter Property="Height" Value="40"/>
              <Setter Property="Padding" Value="0"/>
              <Setter TargetName="Cp" Property="TextElement.FontSize" Value="18"/>
              <Setter TargetName="Cp" Property="FrameworkElement.Margin" Value="0"/>
            </Trigger>
            <!-- Round shape for icon buttons when requested -->
            <Trigger Property="controls:MatButton.IsRound" Value="True">
              <Setter TargetName="Bd" Property="CornerRadius" Value="999"/>
            </Trigger>
            <!-- Variant handling -->
            <Trigger Property="controls:MatButton.Variant" Value="Filled">
              <Setter Property="Background" Value="{StaticResource ButtonBackgroundBrush}"/>
              <Setter Property="BorderBrush" Value="{StaticResource ButtonBackgroundBrush}"/>
            </Trigger>
            <Trigger Property="controls:MatButton.Variant" Value="Outlined">
              <Setter Property="Background" Value="Transparent"/>
              <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
