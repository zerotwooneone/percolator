<Window x:Class="Desktop.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Percolator Chat" Width="1120" Height="720">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Background="{StaticResource SidebarBrush}" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Brand header -->
            <DockPanel Margin="16,12,16,8">
                <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource AccentBrush}"/>
                <TextBlock Text="Percolator" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Search using reusable watermark style -->
            <TextBox Grid.Row="1" Margin="16,4" Style="{StaticResource WatermarkTextBox}" Tag="Search encrypted logs..."/>

            <!-- Sessions list (placeholder) -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Margin="12,8,12,0" Background="#172134" CornerRadius="8" Padding="12">
                        <DockPanel>
                            <Border Width="36" Height="36" CornerRadius="18" Background="#2EC7FF33"/>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="Sarah Connor"/>
                                <TextBlock Text="The encryption keys have b…" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                            </StackPanel>
                            <TextBlock Text="10:42 AM" Foreground="{StaticResource MutedBrush}" FontSize="12" DockPanel.Dock="Right" VerticalAlignment="Top"/>
                        </DockPanel>
                    </Border>
                    <Border Margin="12,8,12,0" Background="#172134" CornerRadius="8" Padding="12">
                        <DockPanel>
                            <Border Width="36" Height="36" CornerRadius="18" Background="#34D39933"/>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="Neo Anderson"/>
                                <TextBlock Text="Follow the white rabbit." Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                            </StackPanel>
                            <TextBlock Text="Yesterday" Foreground="{StaticResource MutedBrush}" FontSize="12" DockPanel.Dock="Right" VerticalAlignment="Top"/>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer current user -->
            <DockPanel Grid.Row="3" Margin="16,8" VerticalAlignment="Bottom">
                <Border Width="28" Height="28" CornerRadius="14" Background="#4F46E533"/>
                <StackPanel Margin="8,0,0,0">
                    <TextBlock Text="Guest User"/>
                    <TextBlock Text="ID: 8X92-A4" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                </StackPanel>
            </DockPanel>
        </Grid>

        <!-- Content area -->
        <Grid Grid.Column="1" Background="{StaticResource SurfaceBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Welcome panel -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="560" TextBlock.TextAlignment="Center">
                    <Border Width="120" Height="120" CornerRadius="60" Background="#0E1727" Opacity="0.9">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="48" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Style="{StaticResource TitleText}" Margin="0,24,0,8" Text="Percolator Secure"/>
                    <TextBlock Foreground="{StaticResource MutedBrush}">
                        Select a conversation from the sidebar to start messaging. All
                        connections are end-to-end encrypted and routed through our
                        secure mesh network.
                    </TextBlock>

                    <!-- Chips -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Border CornerRadius="12" Background="#1A2740" Padding="10,4" Margin="4">
                            <TextBlock Text="AES-256" FontSize="12"/>
                        </Border>
                        <Border CornerRadius="12" Background="#1A2740" Padding="10,4" Margin="4">
                            <TextBlock Text="NO LOGS" FontSize="12"/>
                        </Border>
                        <Border CornerRadius="12" Background="#1A2740" Padding="10,4" Margin="4">
                            <TextBlock Text="P2P" FontSize="12"/>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
