<Window x:Class="Desktop.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Percolator Chat" Width="1120" Height="720">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Background="{StaticResource SidebarBrush}" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Sessions feature host -->
            <ContentControl x:Name="SidebarHost" Grid.Row="1" />
        </Grid>

        <!-- Content area -->
        <Grid Grid.Column="1" Background="{StaticResource SurfaceBrush}">
            <!-- Dynamic content -->
            <ContentControl Content="{Binding CurrentView.Value}" />

            <!-- Welcome panel (visible when no content) -->
            <StackPanel x:Name="WelcomePanel" VerticalAlignment="Center" HorizontalAlignment="Center" Width="560" TextBlock.TextAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentView.Value}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Width="120" Height="120" CornerRadius="60" Background="#0E1727" Opacity="0.9">
                    <TextBlock Style="{StaticResource IconText}" Text="{StaticResource IconShield}" FontSize="48" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <TextBlock Style="{StaticResource TitleText}" Margin="0,24,0,8" Text="Percolator Secure"/>
                <TextBlock Foreground="{StaticResource MutedBrush}">
                    Select a conversation from the sidebar to start messaging. All
                    connections are end-to-end encrypted and routed through the
                    secure mesh network.
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Border Style="{StaticResource Chip}"><TextBlock Text="AES-256" FontSize="12"/></Border>
                    <Border Style="{StaticResource Chip}"><TextBlock Text="NO LOGS" FontSize="12"/></Border>
                    <Border Style="{StaticResource Chip}"><TextBlock Text="P2P" FontSize="12"/></Border>
                </StackPanel>
            </StackPanel>

            <!-- Loading overlay -->
            <Grid Background="#B3000000" Visibility="Collapsed">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLoading.Value}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" TextBlock.TextAlignment="Center" Width="260">
                    <TextBlock Margin="0,0,0,8" Foreground="{StaticResource MutedBrush}" Text="Loading..."/>
                    <ProgressBar IsIndeterminate="True" Height="4"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
