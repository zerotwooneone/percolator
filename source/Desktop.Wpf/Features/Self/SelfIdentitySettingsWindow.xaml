<Window x:Class="Desktop.Wpf.Features.Self.SelfIdentitySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Desktop.Wpf.Shared.Controls"
        Title="Identity Settings" Height="280" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource BaseWindow}">
  <Grid Margin="16" RowDefinitions="Auto,*,Auto">

    <Grid Grid.Row="0" Margin="0,0,0,16">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Style="{StaticResource IconText}" Text="{StaticResource IconUser}" Margin="0,0,10,0"/>
        <TextBlock Style="{StaticResource TitleText}" Text="Identity Settings"/>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto">
      <TextBlock Grid.Row="0" Text="DISPLAY NAME" Foreground="{StaticResource OnSurfaceVariantBrush}" FontSize="12"/>
      <controls:MatInput Grid.Row="1" Margin="0,6,0,0"
                         Text="{Binding DisplayName.Value, UpdateSourceTrigger=PropertyChanged}"
                         Placeholder="Enter your display name" />

      <TextBlock Grid.Row="2" Margin="0,16,0,0" Text="LISTENING PORT" Foreground="{StaticResource OnSurfaceVariantBrush}" FontSize="12"/>
      <Border Grid.Row="2" Margin="0,6,0,0" Style="{StaticResource BaseBorder}" Background="{StaticResource SurfaceContainerLowBrush}" Padding="12" CornerRadius="8">
        <TextBlock Text="{Binding ListeningPort.Value}" FontWeight="SemiBold"/>
      </Border>
    </Grid>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <controls:MatButton Variant="Outlined" Margin="0,0,8,0" Command="{Binding CancelCommand}">
        <TextBlock Text="CANCEL"/>
      </controls:MatButton>
      <controls:MatButton Variant="Filled" Command="{Binding SaveCommand}">
        <TextBlock Text="SAVE"/>
      </controls:MatButton>
    </StackPanel>

  </Grid>
</Window>
