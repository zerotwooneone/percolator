<Window x:Class="Desktop.Wpf.Features.Sessions.ConnectionManagementDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Desktop.Wpf.Shared.Controls"
        Title="Connection Management" Height="620" MinHeight="520" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Style="{StaticResource BaseWindow}">
  <Grid Margin="16" RowDefinitions="Auto,*">

    <Grid Grid.Row="0" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Style="{StaticResource IconText}" Text="{StaticResource IconNetwork}" Margin="0,0,10,0"/>
        <TextBlock Style="{StaticResource TitleText}" Text="Connection Management"/>
      </StackPanel>
    </Grid>

    <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex.Value, Mode=TwoWay}">
      <TabItem Header="Incoming Signals">
        <Grid>
          <Grid.Style>
            <Style TargetType="Grid">
              <Style.Triggers>
                <DataTrigger Binding="{Binding PendingInvitations.Count}" Value="0">
                  <Setter Property="Tag" Value="Empty"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>

          <Border Style="{StaticResource BaseBorder}" Background="{StaticResource SurfaceContainerLowBrush}" Padding="16" CornerRadius="12">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>

              <StackPanel Grid.Row="0">
                <TextBlock Text="PENDING REQUESTS" Foreground="{StaticResource OnSurfaceVariantBrush}" FontSize="12"/>
                <TextBlock Margin="0,6,0,0" Foreground="{StaticResource OnSurfaceVariantBrush}" Text="Approve or burn incoming reverse-signal invitations."/>
              </StackPanel>

              <Grid Grid.Row="1" Margin="0,12,0,0">
                <Grid.Style>
                  <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding PendingInvitations.Count}" Value="0">
                        <Setter Property="Visibility" Value="Collapsed"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Grid.Style>

                <ListBox ItemsSource="{Binding PendingInvitations}" BorderThickness="0" Background="Transparent">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource BaseBorder}" Background="{StaticResource SurfaceContainerLowBrush}" Padding="12" Margin="0,0,0,10">
                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                          <controls:InitialsAvatar Grid.RowSpan="2" Diameter="32" CornerRadius="16" Text="{Binding Initials}"/>

                          <StackPanel Grid.Column="1" Margin="10,0,10,0">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding RelayInfoText}" Foreground="{StaticResource OnSurfaceVariantBrush}" FontSize="12" />
                          </StackPanel>

                          <StackPanel Grid.Column="2" Grid.RowSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <controls:MatButton Variant="Outlined" Margin="0,0,8,0"
                                                Command="{Binding DataContext.BurnInvitationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                              <TextBlock Text="BURN"/>
                            </controls:MatButton>
                            <controls:MatButton Variant="Filled"
                                                Command="{Binding DataContext.AcceptInvitationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                              <TextBlock Text="ACCEPT"/>
                            </controls:MatButton>
                          </StackPanel>

                          <TextBlock Grid.Column="1" Grid.Row="1" Foreground="{StaticResource OnSurfaceVariantBrush}" FontSize="12" Text="{Binding StatusText}"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>

              <Grid Grid.Row="1" Margin="0,12,0,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.Style>
                  <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding PendingInvitations.Count}" Value="0">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Grid.Style>

                <TextBlock Foreground="{StaticResource OnSurfaceVariantBrush}" Text="No pending handshake requests."/>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </TabItem>
      <TabItem Header="Network Search">
        <Grid Margin="0,12,0,0" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">
          <TextBlock Grid.Row="0" Margin="0,14,0,0" Text="DISPLAY NAME (OPTIONAL)" Foreground="{StaticResource OnSurfaceVariantBrush}" FontSize="12"/>
          <controls:MatInput Grid.Row="1" Margin="0,6,0,0"
                             Text="{Binding TargetDisplayNameText.Value, UpdateSourceTrigger=PropertyChanged}"
                             Placeholder="e.g. Alice" />

          <TextBlock Grid.Row="2" Margin="0,14,0,0" Text="ROUTE MODE" Foreground="{StaticResource OnSurfaceVariantBrush}" FontSize="12"/>
          <ComboBox Grid.Row="3" Margin="0,6,0,0"
                    ItemsSource="{Binding RouteModeOptions}"
                    SelectedItem="{Binding SelectedRouteMode.Value, Mode=TwoWay}"
                    DisplayMemberPath="DisplayName" />

          <TextBlock Grid.Row="4" Margin="0,14,0,0" Text="DIRECT ENDPOINT (HOST:PORT)" Foreground="{StaticResource OnSurfaceVariantBrush}" FontSize="12">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SelectedRouteMode.Value.Key}" Value="direct">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <controls:MatInput Grid.Row="5" Margin="0,6,0,0"
                             Text="{Binding DirectEndpointText.Value, UpdateSourceTrigger=PropertyChanged}"
                             Placeholder="e.g. 127.0.0.1:5001">
            <controls:MatInput.Style>
              <Style TargetType="{x:Type controls:MatInput}">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SelectedRouteMode.Value.Key}" Value="direct">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </controls:MatInput.Style>
          </controls:MatInput>

          <TextBlock Grid.Row="6" Margin="0,14,0,0" Text="RELAY HOST" Foreground="{StaticResource OnSurfaceVariantBrush}" FontSize="12">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SelectedRouteMode.Value.Key}" Value="relay">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <ComboBox Grid.Row="7" Margin="0,6,0,0"
                    ItemsSource="{Binding RelayHostOptions}"
                    SelectedItem="{Binding SelectedRelayHost.Value, Mode=TwoWay}"
                    DisplayMemberPath="DisplayName">
            <ComboBox.Style>
              <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SelectedRouteMode.Value.Key}" Value="relay">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ComboBox.Style>
          </ComboBox>

          <Border Grid.Row="8" Margin="0,14,0,0" Style="{StaticResource BaseBorder}" Background="{StaticResource SurfaceContainerLowBrush}" Padding="12">
            <StackPanel>
              <TextBlock Text="PHASE" Foreground="{StaticResource OnSurfaceVariantBrush}" FontSize="12"/>
              <TextBlock Margin="0,6,0,0" Text="{Binding PhaseText.Value}" />
              <TextBlock Margin="0,6,0,0" Foreground="{StaticResource ErrorBrush}" Text="{Binding ErrorText.Value}" />
            </StackPanel>
          </Border>

          <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <controls:MatButton Variant="Filled" Command="{Binding SearchAndConnectCommand}">
              <TextBlock Text="FETCH &amp; INITIATE"/>
            </controls:MatButton>
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="Import Token">
        <Grid Margin="0,12,0,0" RowDefinitions="Auto,*,Auto,Auto">
          <TextBlock Text="OUT-OF-BAND (OOB) TOKEN" Foreground="{StaticResource OnSurfaceVariantBrush}" FontSize="12"/>
          <TextBox Grid.Row="1" Margin="0,6,0,0" Height="200"
                   Style="{StaticResource WatermarkTextBox}"
                   Text="{Binding InviteTokenText.Value, UpdateSourceTrigger=PropertyChanged}"
                   TextWrapping="Wrap" AcceptsReturn="True"
                   VerticalScrollBarVisibility="Auto" />

          <Border Grid.Row="2" Margin="0,14,0,0" Style="{StaticResource BaseBorder}" Background="{StaticResource SurfaceContainerLowBrush}" Padding="12">
            <StackPanel>
              <TextBlock Text="PHASE" Foreground="{StaticResource OnSurfaceVariantBrush}" FontSize="12"/>
              <TextBlock Margin="0,6,0,0" Text="{Binding PhaseText.Value}" />
              <TextBlock Margin="0,6,0,0" Foreground="{StaticResource ErrorBrush}" Text="{Binding ErrorText.Value}" />
            </StackPanel>
          </Border>

          <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <controls:MatButton Variant="Filled" Command="{Binding DecodeAndInitiateCommand}">
              <TextBlock Text="DECODE &amp; INITIATE"/>
            </controls:MatButton>
          </StackPanel>
        </Grid>
      </TabItem>
    </TabControl>

  </Grid>
</Window>
