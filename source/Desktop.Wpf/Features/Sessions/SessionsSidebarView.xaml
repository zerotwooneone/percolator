<UserControl x:Class="Desktop.Wpf.Features.Sessions.SessionsSidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <TextBox Style="{StaticResource WatermarkTextBox}" Tag="Search encrypted logs..." Margin="16,8" Text="{Binding SearchText.Value, UpdateSourceTrigger=PropertyChanged}"/>

    <ListBox Grid.Row="1" ItemsSource="{Binding Items}" SelectedValuePath="Id" SelectedValue="{Binding SelectedSessionId.Value, Mode=TwoWay}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Style="{StaticResource BaseBorder}" Margin="12,8,12,0">
            <DockPanel>
              <Border Width="36" Height="36" CornerRadius="18" Background="#2EC7FF33"/>
              <StackPanel Margin="10,0,0,0">
                <TextBlock Text="{Binding DisplayName}"/>
                <TextBlock Text="{Binding LastMessagePreview}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
              </StackPanel>
              <TextBlock Text="{Binding TimestampText}" Foreground="{StaticResource MutedBrush}" FontSize="12" DockPanel.Dock="Right" VerticalAlignment="Top"/>
            </DockPanel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
