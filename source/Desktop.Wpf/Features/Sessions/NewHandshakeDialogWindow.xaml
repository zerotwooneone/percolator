<Window x:Class="Desktop.Wpf.Features.Sessions.NewHandshakeDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Desktop.Wpf.Shared.Controls"
        xmlns:att="clr-namespace:Desktop.Wpf.Shared.Attached"
        Title="Open Secure Channel" Height="520" Width="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource BaseWindow}">
  <Grid Margin="16" RowDefinitions="Auto,*">

    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Style="{StaticResource TitleText}" Text="Open Secure Channel"/>
      <TextBlock Foreground="{StaticResource OnSurfaceVariantBrush}" Text="Connect to a peer using end-to-end encryption."/>
    </StackPanel>

    <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex.Value, Mode=TwoWay}">
      <TabItem Header="Network Search">
        <Grid Margin="0,12,0,0" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">

          <TextBlock Grid.Row="0" Text="RELAY" Foreground="{StaticResource OnSurfaceVariantBrush}" FontSize="12"/>

          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
            <ComboBox Width="260" ItemsSource="{Binding RelayOptions}" SelectedItem="{Binding SelectedRelay.Value}">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding DisplayText}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Width="12"/>
            <controls:MatInput Width="360"
                               Text="{Binding RelayEndpointText.Value, UpdateSourceTrigger=PropertyChanged}"
                               Placeholder="relay-host:port" />
          </StackPanel>

          <TextBlock Grid.Row="2" Margin="0,14,0,0" Text="TARGET" Foreground="{StaticResource OnSurfaceVariantBrush}" FontSize="12"/>

          <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,6,0,0">
            <controls:MatInput Width="360"
                               Text="{Binding TargetPkhText.Value, UpdateSourceTrigger=PropertyChanged}"
                               Placeholder="Public Key Hash (hex or base64)" />
            <TextBlock Width="12"/>
            <controls:MatInput Width="260"
                               Text="{Binding TargetEndpointText.Value, UpdateSourceTrigger=PropertyChanged}"
                               Placeholder="target-host:port" />
          </StackPanel>

          <Border Grid.Row="4" Margin="0,14,0,0" Style="{StaticResource BaseBorder}" Background="{StaticResource SurfaceContainerLowBrush}" Padding="12">
            <StackPanel>
              <TextBlock Text="PHASE" Foreground="{StaticResource OnSurfaceVariantBrush}" FontSize="12"/>
              <TextBlock Margin="0,6,0,0" Text="{Binding PhaseText.Value}" />
              <TextBlock Margin="0,6,0,0" Foreground="{StaticResource ErrorBrush}" Text="{Binding ErrorText.Value}" />
            </StackPanel>
          </Border>

          <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <controls:MatButton Variant="Filled" Command="{Binding SearchAndConnectCommand}">
              <TextBlock Text="SEARCH &amp; CONNECT"/>
            </controls:MatButton>
          </StackPanel>

        </Grid>
      </TabItem>

      <TabItem Header="Import Token">
        <Grid Margin="0,12,0,0" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">

          <TextBlock Grid.Row="0" Text="DESTINATION" Foreground="{StaticResource OnSurfaceVariantBrush}" FontSize="12"/>
          <controls:MatInput Grid.Row="1" Margin="0,6,0,0"
                             Text="{Binding TargetEndpointText.Value, UpdateSourceTrigger=PropertyChanged}"
                             Placeholder="target-host:port" />

          <TextBlock Grid.Row="2" Margin="0,14,0,0" Text="INVITE TOKEN" Foreground="{StaticResource OnSurfaceVariantBrush}" FontSize="12"/>

          <TextBox Grid.Row="3" Margin="0,6,0,0" Height="160"
                   Style="{StaticResource WatermarkTextBox}"
                   Text="{Binding InviteTokenText.Value, UpdateSourceTrigger=PropertyChanged}"
                   TextWrapping="Wrap" AcceptsReturn="True"
                   VerticalScrollBarVisibility="Auto"
                   att:Placeholder.Text="Paste token here" />

          <Border Grid.Row="4" Margin="0,14,0,0" Style="{StaticResource BaseBorder}" Background="{StaticResource SurfaceContainerLowBrush}" Padding="12">
            <StackPanel>
              <TextBlock Text="PHASE" Foreground="{StaticResource OnSurfaceVariantBrush}" FontSize="12"/>
              <TextBlock Margin="0,6,0,0" Text="{Binding PhaseText.Value}" />
              <TextBlock Margin="0,6,0,0" Foreground="{StaticResource ErrorBrush}" Text="{Binding ErrorText.Value}" />
            </StackPanel>
          </Border>

          <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <controls:MatButton Variant="Filled" Command="{Binding DecodeAndInitiateCommand}">
              <TextBlock Text="CONNECT"/>
            </controls:MatButton>
          </StackPanel>

        </Grid>
      </TabItem>

      <TabItem Header="Generate Invite">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0">
          <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto" Margin="0,0,12,0">

            <TextBlock Grid.Row="0" Text="YOUR INFO" Foreground="{StaticResource OnSurfaceVariantBrush}" FontSize="12"/>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
              <Border Style="{StaticResource Chip}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="PKH" Foreground="{StaticResource OnSurfaceVariantBrush}" Margin="0,0,6,0"/>
                  <TextBlock Text="{Binding SelfPkhText.Value}"/>
                </StackPanel>
              </Border>
              <controls:MatButton Margin="8,0,0,0" Variant="Outlined" Command="{Binding CopySelfPkhCommand}">
                <TextBlock Text="COPY"/>
              </controls:MatButton>
            </StackPanel>

            <TextBlock Grid.Row="2" Margin="0,14,0,0" Text="INVITE TOKEN" Foreground="{StaticResource OnSurfaceVariantBrush}" FontSize="12"/>

            <TextBox Grid.Row="3" Margin="0,6,0,0" Height="180"
                     Style="{StaticResource WatermarkTextBox}"
                     Text="{Binding GeneratedTokenText.Value}"
                     TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     IsReadOnly="True"
                     att:Placeholder.Text="Generate a token" />

            <TextBlock Grid.Row="4" Margin="0,10,0,0" Foreground="{StaticResource OnSurfaceVariantBrush}" Text="{Binding TokenValidityText.Value}"/>

            <Border Grid.Row="5" Margin="0,14,0,0" Style="{StaticResource BaseBorder}" Background="{StaticResource SurfaceContainerLowBrush}" Padding="12">
              <StackPanel>
                <TextBlock Text="PHASE" Foreground="{StaticResource OnSurfaceVariantBrush}" FontSize="12"/>
                <TextBlock Margin="0,6,0,0" Text="{Binding PhaseText.Value}" />
                <TextBlock Margin="0,6,0,0" Foreground="{StaticResource ErrorBrush}" Text="{Binding ErrorText.Value}" />
              </StackPanel>
            </Border>

            <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
              <controls:MatButton Variant="Outlined" Command="{Binding GenerateNewTokenCommand}" Margin="0,0,8,0">
                <TextBlock Text="REGENERATE"/>
              </controls:MatButton>
              <controls:MatButton Variant="Filled" Command="{Binding CopyGeneratedTokenCommand}">
                <TextBlock Text="COPY TOKEN"/>
              </controls:MatButton>
            </StackPanel>

          </Grid>
        </ScrollViewer>
      </TabItem>
    </TabControl>

  </Grid>
</Window>
