<Window x:Class="Desktop.Wpf.Features.Simulator.HandshakeSimulatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Handshake Simulator" Height="420" Width="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource BaseWindow}">
  <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto" ColumnDefinitions="*,Auto">

    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal">
      <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="New Peer:"/>
      <TextBox Width="300" Margin="0,0,8,0" Text="{Binding NewPeerDisplayName.Value, UpdateSourceTrigger=PropertyChanged}"/>
      <Button Content="Add" Command="{Binding AddPeerCommand}"/>
    </StackPanel>

    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,34,0,0">
      <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="Relay:"/>
      <ComboBox Width="300" ItemsSource="{Binding RelayOptions}" SelectedItem="{Binding SelectedRelayOption.Value}">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding DisplayText}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </StackPanel>

    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="Gray" Text="Chunk A: manage simulated peers (add/remove, online toggle, relay-capable toggle). State is persisted under %AppData%/Percolator/simulator-state.json."/>

    <ListBox Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0" ItemsSource="{Binding Peers}" SelectedItem="{Binding SelectedPeer.Value}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <DockPanel LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Width="220" VerticalAlignment="Center" Text="{Binding DisplayText.Value}"/>
            <TextBlock DockPanel.Dock="Left" Width="140" Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding RuntimeStateText.Value}"/>
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="Remove" Command="{Binding RemoveCommand}"/>
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="Fwd" Command="{Binding RelayForwardToMainCommand}"/>
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="InvR" Command="{Binding MainInviteRelayedCommand}"/>
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="Inv" Command="{Binding MainInviteDirectCommand}"/>
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="PInvR" Command="{Binding PeerInviteRelayedCommand}"/>
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="PInv" Command="{Binding PeerInviteDirectCommand}"/>
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="Clear" Command="{Binding ClearRuntimeStateCommand}"/>
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="Est" Command="{Binding MarkEstablishedCommand}"/>
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="In" Command="{Binding MarkInboundPendingCommand}"/>
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="Out" Command="{Binding MarkOutboundPendingCommand}"/>
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="Relay" Command="{Binding ToggleRelayCapableCommand}"/>
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Content="Online" Command="{Binding ToggleOnlineCommand}"/>
          </DockPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Margin="0,16,8,0" Content="Remove Selected" Command="{Binding RemoveSelectedPeerCommand}"/>
      <TextBlock Margin="8,20,0,0" VerticalAlignment="Center" Text="{Binding Status.Value}"/>
    </StackPanel>

  </Grid>
</Window>
