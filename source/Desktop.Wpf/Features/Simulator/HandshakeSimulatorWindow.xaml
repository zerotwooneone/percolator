<Window x:Class="Desktop.Wpf.Features.Simulator.HandshakeSimulatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Handshake Simulator" Height="420" Width="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
  <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" ColumnDefinitions="Auto,*">
    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,8" Text="Display Name:"/>
    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"/>

    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,8" Text="Peer Count:"/>
    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Text="{Binding PeerCount, UpdateSourceTrigger=PropertyChanged}"/>

    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" TextWrapping="Wrap" Foreground="Gray" Text="Simulator generates inbound reverse-signal invites and correlates outbound InviteHandshakeResponse by request_correlation_id."/>

    <ListBox Grid.Row="4" Grid.ColumnSpan="2" Margin="0,12,0,0" ItemsSource="{Binding Peers}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal">
            <TextBlock Width="220" Text="{Binding RequestCorrelationId.Value}"/>
            <TextBlock Width="160" Margin="12,0,0,0" Text="{Binding State}"/>
            <TextBlock Margin="12,0,0,0" Text="{Binding DisplayName}"/>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Margin="0,16,8,0" Content="Simulate" Command="{Binding SimulateCommand}"/>
      <Button Margin="0,16,8,0" Content="Simulate Many" Command="{Binding SimulateManyCommand}"/>
      <Button Margin="0,16,8,0" Content="Correlate Outbound" Command="{Binding CorrelateOutboundCommand}"/>
      <TextBlock Margin="8,20,0,0" VerticalAlignment="Center" Text="{Binding Status}"/>
    </StackPanel>
  </Grid>
</Window>
