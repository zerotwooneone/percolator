<Window x:Class="Desktop.Wpf.Features.Simulator.HandshakeSimulatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Handshake Simulator" Height="260" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
  <Grid Margin="16" RowDefinitions="Auto,Auto,Auto,*,Auto" ColumnDefinitions="Auto,*">
    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,8" Text="Remote PeerId:"/>
    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" Text="Obsolete"/>

    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,8" Text="Display Name:"/>
    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"/>

    <TextBlock Grid.Row="3" Grid.ColumnSpan="2" TextWrapping="Wrap" Foreground="Gray" Text="Enter GUID for PeerId."/>

    <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Margin="0,16,8,0" Content="Simulate" Command="{Binding SimulateCommand}"/>
      <TextBlock Margin="8,20,0,0" VerticalAlignment="Center" Text="{Binding Status}"/>
    </StackPanel>
  </Grid>
</Window>
