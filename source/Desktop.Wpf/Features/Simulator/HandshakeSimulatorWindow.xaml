<Window x:Class="Desktop.Wpf.Features.Simulator.HandshakeSimulatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sim="clr-namespace:Desktop.Wpf.Features.Simulator"
        Title="Protocol Simulator Environment" Height="720" Width="1100"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Style="{StaticResource BaseWindow}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <DataTemplate DataType="{x:Type sim:SimulatorPeersTabViewModel}">
      <sim:SimulatorPeersTabView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type sim:SimulatorHandshakesTabViewModel}">
      <sim:SimulatorHandshakesTabView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type sim:SimulatorRelayTabViewModel}">
      <sim:SimulatorRelayTabView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type sim:SimulatorSessionsTabViewModel}">
      <sim:SimulatorSessionsTabView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type sim:SimulatorDiagnosticsTabViewModel}">
      <sim:SimulatorDiagnosticsTabView />
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid>
      <Grid.Style>
        <Style TargetType="Grid">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsLoading.Value}" Value="True">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Foreground="#EEE" FontSize="20" FontWeight="SemiBold" Text="Loading…" />
        <TextBlock Margin="0,8,0,0" Foreground="#AAA" Text="{Binding Status.Value}" />
      </StackPanel>
    </Grid>

    <Grid>
      <Grid.Style>
        <Style TargetType="Grid">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsLoading.Value}" Value="False">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Grid.Style>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="#111" Padding="12">
        <StackPanel DataContext="{Binding Content.Value}">
          <TextBlock Margin="6,4,6,12" Foreground="#EEE" FontWeight="SemiBold" Text="Simulator" />

          <Button Margin="0,0,0,8" Content="Peers" Command="{Binding SelectTabCommand}" CommandParameter="{x:Static sim:SimulatorTabKind.Peers}" />
          <Button Margin="0,0,0,8" Content="Handshakes" Command="{Binding SelectTabCommand}" CommandParameter="{x:Static sim:SimulatorTabKind.Handshakes}" />
          <Button Margin="0,0,0,8" Content="Relay" Command="{Binding SelectTabCommand}" CommandParameter="{x:Static sim:SimulatorTabKind.Relay}" />
          <Button Margin="0,0,0,8" Content="Sessions" Command="{Binding SelectTabCommand}" CommandParameter="{x:Static sim:SimulatorTabKind.Sessions}" />
          <Button Margin="0,0,0,8" Content="Diagnostics" Command="{Binding SelectTabCommand}" CommandParameter="{x:Static sim:SimulatorTabKind.Diagnostics}" />
        </StackPanel>
      </Border>

      <Grid Grid.Column="1" DataContext="{Binding Content.Value}">
        <Grid.RowDefinitions>
          <RowDefinition Height="56" />
          <RowDefinition Height="*" />
          <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0B0B0B" Padding="16,10">
          <DockPanel>
            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#EEE" FontSize="16" FontWeight="SemiBold" Text="Protocol Simulator Environment" />

            <Menu DockPanel.Dock="Right" VerticalAlignment="Center" Background="Transparent" Foreground="#EEE">
              <MenuItem Header="...">
                <MenuItem Header="Reset simulator state" Command="{Binding ResetSimulatorStateCommand}" />
                <MenuItem Header="Export diagnostic bundle" Command="{Binding ExportDiagnosticsCommand}" />
              </MenuItem>
            </Menu>
          </DockPanel>
        </Border>

        <ContentControl Grid.Row="1" Content="{Binding CurrentTabViewModel.Value}" />

        <Border Grid.Row="2" Background="#0B0B0B" Padding="16,4">
          <TextBlock Foreground="#AAA" TextTrimming="CharacterEllipsis" Text="{Binding Status.Value}" />
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
