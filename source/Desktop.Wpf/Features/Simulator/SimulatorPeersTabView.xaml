<UserControl x:Class="Desktop.Wpf.Features.Simulator.SimulatorPeersTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="16" RowDefinitions="Auto,*,Auto">
    <DockPanel Grid.Row="0" Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Left">
        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Peers" />
        <TextBlock Margin="0,2,0,0" Foreground="Gray" Text="Manage simulated peers and pre-key publishing relationships." />
      </StackPanel>
      <Button DockPanel.Dock="Right" Content="Add Peer" Command="{Binding AddPeerCommand}" />
    </DockPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding PeerCards}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Width="330" Margin="0,0,12,12" Padding="12" BorderThickness="1" BorderBrush="#333" CornerRadius="8">
              <StackPanel>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Left" FontSize="15" FontWeight="SemiBold" Text="{Binding DisplayName.Value}" />
                  <TextBlock DockPanel.Dock="Right" Foreground="#999" Text="{Binding PeerId}" />
                </DockPanel>

                <DockPanel Margin="0,10,0,0">
                  <TextBlock DockPanel.Dock="Left" Foreground="#AAA" Text="PKH:" />
                  <TextBlock DockPanel.Dock="Left" Margin="6,0,0,0" FontFamily="Consolas" Text="{Binding PublicKeyHashShort.Value}" />
                  <Button DockPanel.Dock="Right" Content="Copy" Command="{Binding CopyPublicKeyHashCommand}" />
                </DockPanel>

                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                  <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsRelayCapable.Value}" Content="Enable Relay" />
                  <CheckBox VerticalAlignment="Center" Margin="16,0,0,0" IsChecked="{Binding IsOnline.Value}" Content="Online" />
                </StackPanel>

                <Separator Margin="0,10,0,10" />

                <TextBlock FontWeight="SemiBold" Text="Publish keys" />
                <DockPanel Margin="0,6,0,0">
                  <ComboBox Width="220"
                            ItemsSource="{Binding AvailablePublishTargets}"
                            DisplayMemberPath="Display"
                            SelectedValuePath="PeerId"
                            SelectedValue="{Binding PublishTargetPeerId.Value}" />
                  <Button DockPanel.Dock="Right" Content="Publish" Command="{Binding PublishKeysCommand}" />
                </DockPanel>

                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                  <CheckBox VerticalAlignment="Center" IsChecked="{Binding IncludeOneTimeKeys.Value}" Content="Include OTK" />
                  <TextBlock VerticalAlignment="Center" Margin="12,0,6,0" Foreground="#AAA" Text="Count" />
                  <TextBox Width="48" Text="{Binding OneTimeKeyCount.Value, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Margin="0,10,0,0">
                  <TextBlock Foreground="#AAA" Text="Published to:" />
                  <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding PublishedToTags}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <DockPanel Margin="0,0,0,4">
                          <TextBlock DockPanel.Dock="Left" Text="{Binding Display}" />
                          <Button DockPanel.Dock="Right" Content="X" Command="{Binding RemoveCommand}" />
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <StackPanel Margin="0,10,0,0">
                  <TextBlock Foreground="#AAA" Text="Hosting keys for:" />
                  <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding HostingForTags}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <DockPanel Margin="0,0,0,4">
                          <TextBlock DockPanel.Dock="Left" Text="{Binding Display}" />
                          <Button DockPanel.Dock="Right" Content="X" Command="{Binding RemoveCommand}" />
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <TextBlock Grid.Row="2" Margin="0,12,0,0" Foreground="#888" Text="{Binding Status.Value}" />
  </Grid>
</UserControl>
