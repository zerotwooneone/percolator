<UserControl x:Class="Desktop.Wpf.Features.Simulator.SimulatorPeersTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Desktop.Wpf.Shared.Controls">
  <Grid Margin="16" RowDefinitions="Auto,*,Auto">
    <DockPanel Grid.Row="0" Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Left">
        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Simulated Peers" />
        <TextBlock Margin="0,2,0,0" Foreground="Gray" Text="Manage simulated peers and pre-key publishing relationships." />
      </StackPanel>
      <Button DockPanel.Dock="Right" Padding="12,8" Command="{Binding AddPeerCommand}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{DynamicResource IconPlus}" Style="{StaticResource IconTextSmall}" Margin="0,0,8,0" />
          <TextBlock Text="Add Peer" />
        </StackPanel>
      </Button>
    </DockPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding PeerCards}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="0,0,0,12" Padding="16" BorderThickness="1" BorderBrush="#333" CornerRadius="8" HorizontalAlignment="Stretch">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding DisplayName.Value}" />
                      <Border Margin="10,1,0,0" Padding="8,2" CornerRadius="10" Background="#2A2414" Visibility="{Binding RelayBadgeVisibility.Value}">
                        <TextBlock FontSize="11" Foreground="#F0B14A" Text="RELAY NODE" />
                      </Border>
                    </StackPanel>
                    <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                      <TextBlock Foreground="#AAA" Text="PKH:" />
                      <TextBlock Margin="6,0,6,0" Foreground="#6BB8FF" FontFamily="Consolas" Text="{Binding PublicKeyHashDisplay.Value}" />
                      <controls:MatButton IsIcon="True" Variant="Outlined" Command="{Binding CopyPublicKeyHashCommand}" ToolTip="Copy PKH">
                        <TextBlock Style="{StaticResource IconText}" Text="{StaticResource IconCopy}"/>
                      </controls:MatButton>
                      <controls:MatButton Margin="6,0,0,0" IsIcon="True" Variant="Outlined" Command="{Binding CopyEndpointCommand}" ToolTip="Copy Endpoint (host:port)">
                        <TextBlock Style="{StaticResource IconText}" Text="{StaticResource IconNetwork}"/>
                      </controls:MatButton>
                      <controls:MatButton Margin="6,0,0,0" IsIcon="True" Variant="Outlined" Command="{Binding CopyOobInviteTokenCommand}" ToolTip="Copy OOB Invite Token">
                        <TextBlock Style="{StaticResource IconText}" Text="{StaticResource IconApplicationExport}"/>
                      </controls:MatButton>
                    </StackPanel>
                  </StackPanel>

                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <CheckBox VerticalAlignment="Center" Margin="0,2,10,0" IsChecked="{Binding IsRelayCapable.Value}" Content="Enable Relay" />
                  </StackPanel>
                </Grid>

                <Expander Margin="0,12,0,0" Header="Pre-key publishing">
                  <StackPanel Margin="0,10,0,0">
                    <TextBlock FontWeight="SemiBold" Text="Publish keys" />
                    <DockPanel Margin="0,6,0,0">
                      <ComboBox Width="260"
                                ItemsSource="{Binding AvailablePublishTargets}"
                                DisplayMemberPath="Display"
                                SelectedValuePath="PeerId.Value"
                                SelectedValue="{Binding PublishTargetPeerId.Value}" />
                      <Button DockPanel.Dock="Right" Content="Publish" Command="{Binding PublishKeysCommand}" />
                    </DockPanel>

                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                      <CheckBox VerticalAlignment="Center" IsChecked="{Binding IncludeOneTimeKeys.Value}" Content="Include OTK" />
                      <TextBlock VerticalAlignment="Center" Margin="12,0,6,0" Foreground="#AAA" Text="Count" />
                      <TextBox Width="48" Text="{Binding OneTimeKeyCount.Value, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Margin="0,12,0,0">
                      <TextBlock Foreground="#AAA" Text="Published to:" />
                      <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding PublishedToTags}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <DockPanel Margin="0,0,0,4">
                              <TextBlock DockPanel.Dock="Left" Text="{Binding Display}" />
                              <Button DockPanel.Dock="Right" Content="X" Command="{Binding RemoveCommand}" />
                            </DockPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>

                    <StackPanel Margin="0,12,0,0">
                      <TextBlock Foreground="#AAA" Text="Hosting keys for:" />
                      <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding HostingForTags}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <DockPanel Margin="0,0,0,4">
                              <TextBlock DockPanel.Dock="Left" Text="{Binding Display}" />
                              <Button DockPanel.Dock="Right" Content="X" Command="{Binding RemoveCommand}" />
                            </DockPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </StackPanel>
                </Expander>
                <Expander Margin="0,12,0,0" Header="Chat">
                  <StackPanel Margin="0,10,0,0">
                    <ListBox MaxHeight="200" ItemsSource="{Binding ChatViewModel.Messages}">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <StackPanel Margin="4">
                            <TextBlock FontWeight="SemiBold" Text="{Binding Direction}"/>
                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap"/>
                            <TextBlock Foreground="#888" FontSize="10" Text="{Binding Timestamp, StringFormat='{}yyyy-MM-dd HH:mm:ss'}"/>
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <DockPanel Margin="0,6,0,0">
                      <Button DockPanel.Dock="Right" Content="Send" Command="{Binding ChatViewModel.SendMessageCommand}" />
                      <TextBox Text="{Binding ChatViewModel.MessageInput.Value, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <TextBlock Grid.Row="2" Margin="0,12,0,0" Foreground="#888" Text="{Binding Status.Value}" />
  </Grid>
</UserControl>
