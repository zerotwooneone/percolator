<UserControl x:Class="Desktop.Wpf.Features.Simulator.SimulatorSessionsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="16" RowDefinitions="Auto,*">
    <StackPanel>
      <TextBlock FontSize="18" FontWeight="SemiBold" Text="Sessions" />
      <TextBlock Margin="0,6,0,0" Foreground="#8AFFFFFF" TextWrapping="Wrap"
                 Text="Ratchet inspection: watch send/recv counters and skipped keys change as MESSAGE payloads are delivered (including out-of-order)." />
    </StackPanel>

    <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Cards}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="0,0,0,12" Padding="12" CornerRadius="8" BorderBrush="#1FFFFFFF" BorderThickness="1">
              <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*">
                <StackPanel Grid.Row="0" Grid.ColumnSpan="2">
                  <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#FFFFFF" Text="{Binding PeerName.Value}" />
                  <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="#8AFFFFFF" Text="{Binding PeerIdShort.Value}" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
                  <TextBlock FontSize="12" Foreground="#8AFFFFFF" Text="Root Key" />
                  <TextBlock FontFamily="Consolas" FontSize="12" Foreground="#67D7FF" Text="{Binding RootKeyHash.Value}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,10,0,0">
                  <TextBlock FontSize="12" Foreground="#8AFFFFFF" Text="Sending chain index" />
                  <TextBlock FontFamily="Consolas" FontSize="12" Foreground="#FFFFFF" Text="{Binding SendingChainIndex.Value}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="1" Margin="12,10,0,0">
                  <TextBlock FontSize="12" Foreground="#8AFFFFFF" Text="Receiving chain index" />
                  <TextBlock FontFamily="Consolas" FontSize="12" Foreground="#FFFFFF" Text="{Binding ReceivingChainIndex.Value}" />
                  <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="#8AFFFFFF" Text="Skipped keys" />
                  <TextBlock FontFamily="Consolas" FontSize="12" Foreground="#FFFFFF" Text="{Binding SkippedKeysCount.Value}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
