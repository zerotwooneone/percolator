<UserControl x:Class="Desktop.Wpf.Features.Simulator.SimulatorDiagnosticsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="16" RowDefinitions="Auto,Auto,*">
    <StackPanel Grid.Row="0">
      <TextBlock FontSize="18" FontWeight="SemiBold" Text="Diagnostics" />
      <TextBlock Margin="0,6,0,0" Foreground="#8AFFFFFF" TextWrapping="Wrap" Text="Chronological event log for simulator actions (relay, handshakes, decrypt failures). Use filters to narrow." />
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,12,0,12" ColumnDefinitions="*,*,*,Auto">
      <ComboBox Grid.Column="0" Margin="0,0,10,0"
                ItemsSource="{Binding PeerFilterOptions.Value}"
                DisplayMemberPath="Display"
                SelectedValuePath="Value"
                SelectedValue="{Binding SelectedPeerId.Value}" />

      <ComboBox Grid.Column="1" Margin="0,0,10,0"
                ItemsSource="{Binding RelayFilterOptions.Value}"
                DisplayMemberPath="Display"
                SelectedValuePath="Value"
                SelectedValue="{Binding SelectedRelayHostPeerId.Value}" />

      <ComboBox Grid.Column="2" Margin="0,0,10,0"
                ItemsSource="{Binding EventTypeFilterOptions.Value}"
                DisplayMemberPath="Display"
                SelectedValuePath="Value"
                SelectedValue="{Binding SelectedEventType.Value}" />

      <Button Grid.Column="3" Content="Clear" Padding="12,6" Command="{Binding ClearCommand}" />
    </Grid>

    <Border Grid.Row="2" BorderBrush="#333" BorderThickness="1" CornerRadius="8" Padding="10">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Events}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,8" Padding="10" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="6">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <TextBlock Grid.Column="0" FontFamily="Consolas" Foreground="#AAA" Text="{Binding TimestampUtc, StringFormat={}{0:HH:mm:ss.fff}}" />
                  <TextBlock Grid.Column="1" Margin="12,0,0,0" Foreground="#67D7FF" Text="{Binding Message}" TextWrapping="Wrap" />
                  <TextBlock Grid.Column="2" Margin="12,0,0,0" Foreground="#888" Text="{Binding EventType}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
