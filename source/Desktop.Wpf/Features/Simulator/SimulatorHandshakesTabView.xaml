<UserControl x:Class="Desktop.Wpf.Features.Simulator.SimulatorHandshakesTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:Desktop.Wpf.Shared.Theme">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <theme:SimulatorPeerUiStateToHandshakeBadgeBrushConverter x:Key="HandshakeBadgeBrushConverter" />
  </UserControl.Resources>
  <Grid Margin="16" RowDefinitions="Auto,*">
    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock FontSize="18" FontWeight="SemiBold" Text="Handshake State Machines" />
      <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
        <TextBlock VerticalAlignment="Center" Text="Relay host:" />
        <ComboBox Margin="8,0,0,0"
                  Width="260"
                  ItemsSource="{Binding RelayHosts}"
                  DisplayMemberPath="DisplayName"
                  SelectedValuePath="PeerId"
                  SelectedValue="{Binding SelectedRelayHostPeerId.Value, Mode=TwoWay}" />
      </StackPanel>
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Cards}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="0,0,0,12" Padding="16" BorderThickness="1" BorderBrush="#333" CornerRadius="8" HorizontalAlignment="Stretch">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding DisplayName.Value}" />

                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                  <Border Padding="10,4" CornerRadius="6" Background="{Binding UiState.Value, Converter={StaticResource HandshakeBadgeBrushConverter}}" HorizontalAlignment="Right">
                    <TextBlock FontSize="11" Foreground="#E6E6E6" Text="{Binding StateBadgeText.Value}" />
                  </Border>

                  <StackPanel Margin="0,10,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Visibility="{Binding ShowReset.Value, Converter={StaticResource BoolToVis}}" Content="Reset State" Command="{Binding ResetStateCommand}" />
                    <Button Margin="8,0,0,0" Visibility="{Binding ShowForceExpire.Value, Converter={StaticResource BoolToVis}}" Content="Force Expire" Command="{Binding ForceExpireCommand}" />
                    <Button Margin="8,0,0,0" Visibility="{Binding ShowAcceptReverseSignal.Value, Converter={StaticResource BoolToVis}}" Content="Accept Handshake" Command="{Binding AcceptHandshakeCommand}" />
                    <Button Margin="8,0,0,0" Visibility="{Binding ShowSendRequest.Value, Converter={StaticResource BoolToVis}}" Content="Send Direct Request" Command="{Binding SendRequestToMainCommand}" />
                    <Button Margin="8,0,0,0" Visibility="{Binding ShowSendRequest.Value, Converter={StaticResource BoolToVis}}" Content="Send Relayed Request" Command="{Binding SendRelayedRequestToMainCommand}" />
                  </StackPanel>


                  <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding PendingStandardSignalHellos.Value}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <DockPanel LastChildFill="False" Margin="0,0,0,6">
                          <Button DockPanel.Dock="Right"
                                  Margin="10,0,0,0"
                                  Content="Accept"
                                  Command="{Binding DataContext.AcceptPendingStandardSignalHelloCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                  CommandParameter="{Binding InitiatorPkhHex}" />
                          <TextBlock VerticalAlignment="Center" Text="{Binding InitiatorPkhHex}" />
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
