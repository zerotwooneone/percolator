<UserControl x:Class="Desktop.Wpf.Features.Chat.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:att="clr-namespace:Desktop.Wpf.Shared.Attached"
             xmlns:controls="clr-namespace:Desktop.Wpf.Shared.Controls"
             xmlns:converters="clr-namespace:Desktop.Wpf.Shared.Converters"
             xmlns:componentModel="clr-namespace:System.ComponentModel;assembly=WindowsBase">
  <UserControl.Resources>
    <converters:DateTimeOffsetToStringConverter x:Key="DateTimeOffsetToStringConverter"/>
    <CollectionViewSource x:Key="MessagesView" Source="{Binding Messages}">
      <CollectionViewSource.SortDescriptions>
        <componentModel:SortDescription PropertyName="Timestamp" Direction="Ascending" />
      </CollectionViewSource.SortDescriptions>
    </CollectionViewSource>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0" Margin="12,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <controls:InitialsAvatar Diameter="28" CornerRadius="14" Text="{Binding Initials.Value}" IsOnline="{Binding IsOnline.Value}"/>
        <StackPanel Margin="10,0,0,0">
          <TextBlock Text="{Binding Title.Value}" FontWeight="SemiBold"/>
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
        <!-- Phone -->
        <controls:MatButton IsIcon="True" IsRound="True" Variant="Filled" Margin="0,0,8,0">
          <TextBlock Style="{StaticResource IconText}" Text="{StaticResource IconPhone}"/>
        </controls:MatButton>
        <!-- Video -->
        <controls:MatButton IsIcon="True" IsRound="True" Variant="Filled" Margin="0,0,8,0">
          <TextBlock Style="{StaticResource IconText}" Text="{StaticResource IconVideo}"/>
        </controls:MatButton>
        <!-- Vertical separator bar -->
        <Border Width="1" Height="24" Background="#263246" CornerRadius="1" Margin="0,0,8,0" VerticalAlignment="Center"/>
        <!-- Network status button toggles side panel -->
        <controls:MatButton IsIcon="True" IsRound="True" Variant="Filled"
                            Command="{Binding ToggleNetworkCommand}">
          <TextBlock Style="{StaticResource IconText}" Text="{StaticResource IconNetwork}"/>
        </controls:MatButton>
      </StackPanel>
    </Grid>

    <!-- Messages -->
    <ScrollViewer x:Name="MessagesScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Source={StaticResource MessagesView}}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="12,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="Bubble" Grid.Column="0" Background="#203047" CornerRadius="12" Padding="10" MaxWidth="520">
                <StackPanel>
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                    <TextBlock Text="{Binding Timestamp, Converter={StaticResource DateTimeOffsetToStringConverter}, StringFormat=t}" Foreground="{StaticResource OnSurfaceVariantBrush}" FontSize="11"/>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border x:Name="OwnBubble" Grid.Column="1" Background="#2EC7FF22" CornerRadius="12" Padding="10" MaxWidth="520" Visibility="Collapsed">
                <StackPanel>
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                    <TextBlock x:Name="SingleTick" Style="{StaticResource IconText}" Text="{StaticResource IconCheck}" FontSize="12" Margin="0,0,6,0" Opacity="0.9" Visibility="Collapsed"/>
                    <TextBlock x:Name="DoubleTick" Style="{StaticResource IconText}" Text="{StaticResource IconDoubleCheck}" FontSize="12" Margin="0,0,6,0" Opacity="0.9" Visibility="Collapsed"/>
                    <TextBlock Text="{Binding Timestamp, Converter={StaticResource DateTimeOffsetToStringConverter}, StringFormat=t}" Foreground="{StaticResource OnSurfaceVariantBrush}" FontSize="11"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsOwn}" Value="True">
                <Setter TargetName="Bubble" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="OwnBubble" Property="Visibility" Value="Visible"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding IsRead.Value}" Value="True">
                <Setter TargetName="SingleTick" Property="UIElement.Visibility" Value="Collapsed"/>
                <Setter TargetName="DoubleTick" Property="UIElement.Visibility" Value="Visible"/>
              </DataTrigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsDelivered.Value}" Value="True"/>
                  <Condition Binding="{Binding IsRead.Value}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="SingleTick" Property="UIElement.Visibility" Value="Visible"/>
                <Setter TargetName="DoubleTick" Property="UIElement.Visibility" Value="Collapsed"/>
              </MultiDataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Composer -->
    <controls:ChatComposer Grid.Row="2"
                           Text="{Binding MessageInput.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           CanSend="{Binding CanSend.Value}"
                           SendCommand="{Binding SendCommand}"/>

    <!-- Network side panel (mockup-aligned) with slide animation -->
    <Border Grid.RowSpan="4" Panel.ZIndex="99" HorizontalAlignment="Right" Width="360" Background="#101827" BorderBrush="#243047" BorderThickness="1" Opacity="0" IsHitTestVisible="True">
      <Border.RenderTransform>
        <TranslateTransform X="360"/>
      </Border.RenderTransform>
      <!-- No automatic animation on load to avoid flashing; only animate on IsNetworkOpen changes -->
      <Border.Style>
        <Style TargetType="Border">
          <Style.Triggers>
            <DataTrigger Binding="{Binding IsNetworkOpen.Value}" Value="True">
              <DataTrigger.EnterActions>
                <BeginStoryboard Storyboard="{StaticResource SlideInRightFast}"/>
              </DataTrigger.EnterActions>
              <DataTrigger.ExitActions>
                <BeginStoryboard Storyboard="{StaticResource SlideOutRightFast}"/>
              </DataTrigger.ExitActions>
            </DataTrigger>
            <!-- When false, do not animate on entry (startup) -->
            <DataTrigger Binding="{Binding IsNetworkOpen.Value}" Value="False"/>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Border Background="#0B1220" Padding="16,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource IconText}" Text="{StaticResource IconNetwork}" Margin="0,0,8,0"/>
              <TextBlock Text="Network Graph" FontWeight="SemiBold"/>
            </StackPanel>
            <controls:MatButton Grid.Column="1" IsIcon="True" Variant="Filled" Command="{Binding CloseNetworkCommand}">
              <TextBlock Text="✕"/>
            </controls:MatButton>
          </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" Background="Transparent">
          <StackPanel Margin="16">
            <!-- Current Route -->
            <TextBlock Text="CURRENT ROUTE" Foreground="{StaticResource OnSurfaceVariantBrush}" FontSize="11"/>
            <Border Style="{StaticResource BaseBorder}" Margin="0,8,0,16" Background="#0F1626">
              <Grid Margin="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="Status" FontWeight="SemiBold"/>
                  <TextBlock Text="Connected directly (P2P)." Foreground="{StaticResource OnSurfaceVariantBrush}" FontSize="12">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsRelayed.Value}" Value="True">
                            <Setter Property="Text" Value="Routed via encrypted relay node."/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
                <Border Grid.Column="1" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                  <Grid>
                    <StackPanel Orientation="Horizontal">
                      <StackPanel.Style>
                        <Style TargetType="StackPanel">
                          <Setter Property="Visibility" Value="Visible"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRelayed.Value}" Value="True">
                              <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </StackPanel.Style>
                      <TextBlock Style="{StaticResource IconText}" Text="{StaticResource IconLock}" Margin="0,0,6,0"/>
                      <TextBlock Text="DIRECT"/>
                    </StackPanel>
                    <StackPanel x:Name="BadgeRelayed" Orientation="Horizontal">
                      <StackPanel.Style>
                        <Style TargetType="StackPanel">
                          <Setter Property="Visibility" Value="Collapsed"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRelayed.Value}" Value="True">
                              <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </StackPanel.Style>
                      <TextBlock Style="{StaticResource IconText}" Text="{StaticResource IconCloudLock}" Margin="0,0,6,0"/>
                      <TextBlock Text="RELAYED"/>
                    </StackPanel>
                  </Grid>
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="Background" Value="#17312A"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRelayed.Value}" Value="True">
                          <Setter Property="Background" Value="#2B2233"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRelayed.Value}" Value="False">
                          <Setter Property="Background" Value="#17312A"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                </Border>
              </Grid>
            </Border>

            <!-- Discovery Settings -->
            <TextBlock Text="DISCOVERY SETTINGS" Foreground="{StaticResource OnSurfaceVariantBrush}" FontSize="11"/>
            <Border Style="{StaticResource BaseBorder}" Margin="0,8,0,16" Background="#0F1626">
              <StackPanel Margin="12">
                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Find Neighbors" FontWeight="SemiBold"/>
                    <TextBlock Text="Query this peer for new nodes" Foreground="{StaticResource OnSurfaceVariantBrush}" FontSize="12"/>
                  </StackPanel>
                  <controls:MatButton Grid.Column="1" IsIcon="True" Variant="Filled">
                    <TextBlock Style="{StaticResource IconText}" Text="{StaticResource IconRefresh}"/>
                  </controls:MatButton>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Auto-Discovery" FontWeight="SemiBold"/>
                    <TextBlock Text="Periodically request peers" Foreground="{StaticResource OnSurfaceVariantBrush}" FontSize="12"/>
                  </StackPanel>
                  <controls:MatSlideToggle Grid.Column="1" IsChecked="{Binding AutoDiscoveryEnabled.Value, Mode=TwoWay}"/>
                </Grid>
              </StackPanel>
            </Border>

            <!-- Discovered Peers -->
            <TextBlock Text="DISCOVERED PEERS" Foreground="{StaticResource OnSurfaceVariantBrush}" FontSize="11"/>
            <StackPanel Margin="0,8,0,12">
              <!-- Sample peer cards -->
              <Border Style="{StaticResource BaseBorder}" Background="#0F1626" Margin="0,0,0,8" Padding="12">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <Ellipse Width="8" Height="8" Fill="#29D391"/>
                      <TextBlock Text="0x8F3A-22B1..." Margin="8,0,0,0"/>
                    </StackPanel>
                    <controls:MatChip Icon="{StaticResource IconDirect}" Text="Direct Route"/>
                  </StackPanel>
                  <controls:MatButton Grid.Column="1" Variant="Filled">Connect</controls:MatButton>
                </Grid>
              </Border>
              <Border Style="{StaticResource BaseBorder}" Background="#0F1626" Margin="0,0,0,8" Padding="12">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <Ellipse Width="8" Height="8" Fill="#FFB020"/>
                      <TextBlock Text="0x1C9D-44F2..." Margin="8,0,0,0"/>
                    </StackPanel>
                    <controls:MatChip Icon="{StaticResource IconRelay}" Text="Relayed Route"/>
                  </StackPanel>
                  <controls:MatButton Grid.Column="1" Variant="Filled">Connect</controls:MatButton>
                </Grid>
              </Border>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
