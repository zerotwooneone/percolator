<UserControl x:Class="Desktop.Wpf.Features.Chat.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:att="clr-namespace:Desktop.Wpf.Shared.Attached">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0" Margin="12,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <Border Width="28" Height="28" CornerRadius="14" Background="#2EC7FF33">
          <TextBlock Text="{Binding Initials.Value}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/>
        </Border>
        <StackPanel Margin="10,0,0,0">
          <TextBlock Text="{Binding Title.Value}" FontWeight="SemiBold"/>
          <TextBlock Text="SIGNAL SECURE" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Style="{StaticResource BaseButton}" Width="32" Height="32" Padding="0" Margin="0,0,8,0"><TextBlock Style="{StaticResource IconText}" Text="{StaticResource IconPhone}"/></Button>
        <Button Style="{StaticResource BaseButton}" Width="32" Height="32" Padding="0" Margin="0,0,8,0"><TextBlock Style="{StaticResource IconText}" Text="{StaticResource IconVideo}"/></Button>
        <Button Style="{StaticResource BaseButton}" Width="32" Height="32" Padding="0"><TextBlock Style="{StaticResource IconText}" Text="{StaticResource IconKebab}"/></Button>
      </StackPanel>
    </Grid>

    <!-- Secure chip -->
    <Border Grid.Row="1" HorizontalAlignment="Center" Background="#1A2740" CornerRadius="16" Padding="10,6" Margin="0,0,0,4">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Ellipse Width="8" Height="8" Fill="#29D391" VerticalAlignment="Center"/>
        <TextBlock Style="{StaticResource IconText}" Text="{StaticResource IconLock}" Margin="8,0,4,0" Opacity="0.9"/>
        <TextBlock Text="END-TO-END ENCRYPTED" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
      </StackPanel>
    </Border>

    <!-- Messages -->
    <ScrollViewer x:Name="MessagesScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Messages}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="12,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="Bubble" Grid.Column="0" Background="#203047" CornerRadius="12" Padding="10" MaxWidth="520">
                <StackPanel>
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                    <TextBlock Text="{Binding TimestampText}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border x:Name="OwnBubble" Grid.Column="1" Background="#2EC7FF22" CornerRadius="12" Padding="10" MaxWidth="520" Visibility="Collapsed">
                <StackPanel>
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                    <TextBlock x:Name="SingleTick" Style="{StaticResource IconText}" Text="{StaticResource IconCheck}" FontSize="12" Margin="0,0,6,0" Opacity="0.9" Visibility="Collapsed"/>
                    <TextBlock x:Name="DoubleTick" Style="{StaticResource IconText}" Text="{StaticResource IconDoubleCheck}" FontSize="12" Margin="0,0,6,0" Opacity="0.9" Visibility="Collapsed"/>
                    <TextBlock Text="{Binding TimestampText}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsOwn}" Value="True">
                <Setter TargetName="Bubble" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="OwnBubble" Property="Visibility" Value="Visible"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding IsRead.Value}" Value="True">
                <Setter TargetName="SingleTick" Property="UIElement.Visibility" Value="Collapsed"/>
                <Setter TargetName="DoubleTick" Property="UIElement.Visibility" Value="Visible"/>
              </DataTrigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsDelivered.Value}" Value="True"/>
                  <Condition Binding="{Binding IsRead.Value}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="SingleTick" Property="UIElement.Visibility" Value="Visible"/>
                <Setter TargetName="DoubleTick" Property="UIElement.Visibility" Value="Collapsed"/>
              </MultiDataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Composer -->
    <DockPanel Grid.Row="3" Margin="12" LastChildFill="True">
      <!-- Right action buttons: emoji, clip, send -->
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Style="{StaticResource BaseButton}" Width="36" Height="36" Margin="8,0,0,0" Padding="0">
          <TextBlock Style="{StaticResource IconText}" Text="{StaticResource IconSmiley}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>
        <Button Style="{StaticResource BaseButton}" Width="36" Height="36" Margin="8,0,0,0" Padding="0">
          <TextBlock Style="{StaticResource IconText}" Text="{StaticResource IconClip}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>
        <Button Style="{StaticResource BaseButton}" Width="44" Height="36" Margin="8,0,0,0" Padding="0"
                IsEnabled="{Binding CanSend.Value}" Command="{Binding SendCommand}">
          <TextBlock Style="{StaticResource IconText}" Text="{StaticResource IconSend}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>
      </StackPanel>
      <!-- Left plus button -->
      <Button DockPanel.Dock="Left" Style="{StaticResource BaseButton}" Width="36" Height="36" Margin="0,0,8,0" Padding="0">
        <TextBlock Style="{StaticResource IconText}" Text="{StaticResource IconPlus}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Button>
      <!-- Message input -->
      <TextBox x:Name="Composer" Style="{StaticResource WatermarkTextBox}" att:Placeholder.Text="Type a message..."
               MinHeight="36"
               AcceptsReturn="True" TextWrapping="Wrap"
               att:KeyBehaviors.EnterCommand="{Binding SendCommand}"
               att:KeyBehaviors.AllowAltEnterNewline="True"
               Text="{Binding MessageInput.Value, UpdateSourceTrigger=PropertyChanged}"/>
    </DockPanel>
  </Grid>
</UserControl>
