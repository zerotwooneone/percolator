<UserControl x:Class="Desktop.Wpf.Features.Chat.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:att="clr-namespace:Desktop.Wpf.Shared.Attached">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Messages -->
    <ScrollViewer x:Name="MessagesScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Messages}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid Margin="12,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="Bubble" Grid.Column="0" Background="#203047" CornerRadius="12" Padding="10" MaxWidth="520">
                <StackPanel>
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding TimestampText}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Right"/>
                </StackPanel>
              </Border>
              <Border x:Name="OwnBubble" Grid.Column="1" Background="#2EC7FF22" CornerRadius="12" Padding="10" MaxWidth="520" Visibility="Collapsed">
                <StackPanel>
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding TimestampText}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Right"/>
                </StackPanel>
              </Border>
            </Grid>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsOwn}" Value="True">
                <Setter TargetName="Bubble" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="OwnBubble" Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Composer -->
    <DockPanel Grid.Row="1" Margin="12" LastChildFill="True">
      <!-- Right action buttons: emoji, clip, send -->
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Style="{StaticResource BaseButton}" Width="36" Height="36" Margin="8,0,0,0" Padding="0">
          <TextBlock Style="{StaticResource IconText}" Text="{StaticResource IconSmiley}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>
        <Button Style="{StaticResource BaseButton}" Width="36" Height="36" Margin="8,0,0,0" Padding="0">
          <TextBlock Style="{StaticResource IconText}" Text="{StaticResource IconClip}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>
        <Button Style="{StaticResource BaseButton}" Width="44" Height="36" Margin="8,0,0,0" Padding="0"
                IsEnabled="{Binding CanSend.Value}" Command="{Binding SendCommand}">
          <TextBlock Style="{StaticResource IconText}" Text="{StaticResource IconSend}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>
      </StackPanel>
      <!-- Left plus button -->
      <Button DockPanel.Dock="Left" Style="{StaticResource BaseButton}" Width="36" Height="36" Margin="0,0,8,0" Padding="0">
        <TextBlock Style="{StaticResource IconText}" Text="{StaticResource IconPlus}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Button>
      <!-- Message input -->
      <TextBox Style="{StaticResource WatermarkTextBox}" att:Placeholder.Text="Type a message..."
               MinHeight="36" Text="{Binding MessageInput.Value, UpdateSourceTrigger=PropertyChanged}"/>
    </DockPanel>
  </Grid>
</UserControl>
