<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    </PropertyGroup>

    <ItemGroup>
        <Folder Include="Models\" />
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="11.2.5" />
        <PackageReference Include="Avalonia.Desktop" Version="11.2.5" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.5" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.5" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="FluentAvaloniaUI" Version="2.1.0" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
        <PackageReference Include="R3" Version="1.3.1" />
        <PackageReference Include="R3Extensions.Avalonia" Version="1.3.1" />
        <PackageReference Include="ObservableCollections.R3" Version="3.3.4" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
        <!-- Pin patched Tmds.DBus.Protocol to clear NU1903 (transitive via Avalonia.FreeDesktop) -->
        <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    </ItemGroup>

    <!-- InternalsVisibleTo for unit-testing internal facades/helpers (WIN-02 geometry store + math). -->
    <ItemGroup>
        <InternalsVisibleTo Include="Percolator.Desktop.Tests" />
    </ItemGroup>

    <!-- Vendored Signal.Interop for the native signal_shim smoke test ([DEP-DESKTOP-STARTUP-VAULT-AUTHENTICATION]) -->
    <ItemGroup>
        <Reference Include="Signal.Interop">
            <HintPath>..\vendor\Signal.Interop\Signal.Interop.dll</HintPath>
        </Reference>
        <Content Include="..\vendor\Signal.Interop\runtimes\**\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Link>runtimes\%(RecursiveDir)%(Filename)%(Extension)</Link>
            <Visible>false</Visible>
        </Content>
    </ItemGroup>

    <!-- Project References -->
    <ItemGroup>
        <ProjectReference Include="..\Percolator.Domain\Percolator.Domain.csproj" />
        <ProjectReference Include="..\Percolator.Application\Percolator.Application.csproj" />
        <ProjectReference Include="..\Percolator.Infrastructure\Percolator.Infrastructure.csproj" />
        <ProjectReference Include="..\Percolator.PluginSdk\Percolator.PluginSdk.csproj" />
        <ProjectReference Include="..\Percolator.Apps.Chat\Percolator.Apps.Chat.csproj" />
        <ProjectReference Include="..\Percolator.Apps.Discovery\Percolator.Apps.Discovery.csproj" />
        <ProjectReference Include="..\Percolator.Apps.FileTransfer\Percolator.Apps.FileTransfer.csproj" />
    </ItemGroup>

</Project>
