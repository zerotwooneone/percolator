<!-- SPECIFICATION GOVERNANCE: Read Percolator.Desktop/spec/Style.spec.md before modifying this file. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Destructive action button ([STYLE-002], [STYLE-004], [STYLE-008]):
         baseline brushes via classed style setter so :pointerover triggers still apply. -->
    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Style Selector="^:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
        </Style>
        <Style Selector="^:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        </Style>
        <Style Selector="^:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </Style>

    <!-- Persona selection card ([STYLE-002], [STYLE-005], [STYLE-008]):
         hover brush transition animates the CardBackgroundFill semantic tokens. -->
    <Style Selector="Border.persona-card">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.167" />
            </Transitions>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
        </Style>
    </Style>

    <!-- Flat icon-only shell chrome button for sidebars and headers. -->
    <Style Selector="Button.shell-icon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="8" />
        <Style Selector="^:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="^:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
        </Style>
    </Style>

    <!-- Identity Gate: port-status pill ([STYLE-002], [STYLE-004] semantic tokens). -->
    <Style Selector="Border.port-pill">
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.port-pill.ready">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}" />
    </Style>
    <Style Selector="Border.port-pill.auto">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCautionBrush}" />
    </Style>
    <Style Selector="Border.port-pill.busy">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
    </Style>

    <!-- Identity Gate: inline banner for port-conflict / recovery messaging. -->
    <Style Selector="Border.banner">
        <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorAttentionBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <!-- Deterministic identicon backdrop used on cards and the persona editor. -->
    <Style Selector="Border.identicon-tile">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <!-- Persona-card selection host: invisible toggle chrome, accent ring while checked. -->
    <Style Selector="ToggleButton.persona-toggle">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Style Selector="^:checked Border.persona-card">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
    </Style>

    <!-- Flat inline button next to the port pill (opens the editor flyout). -->
    <Style Selector="Button.pill-edit">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="2,0" />
        <Style Selector="^:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Style>
    </Style>

</Styles>
