<!-- SPECIFICATION GOVERNANCE: Read Percolator.Desktop/spec/View.spec.md before modifying this file. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Percolator.Desktop.Features.Chats.ViewModels"
             x:Class="Percolator.Desktop.Features.Chats.Controls.ReactionPickerFlyout"
             x:DataType="vm:ChatMessageViewModel">

    <Border Background="{DynamicResource SurfaceSubtleBrush}"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="4"
            BoxShadow="0 4 12 0 #40000000">
        <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Content="👍"
                    Command="{Binding AddReactionCommand}"
                    CommandParameter="👍"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="18"
                    Padding="6,4"
                    Cursor="Hand" />
            <Button Content="❤️"
                    Command="{Binding AddReactionCommand}"
                    CommandParameter="❤️"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="18"
                    Padding="6,4"
                    Cursor="Hand" />
            <Button Content="😂"
                    Command="{Binding AddReactionCommand}"
                    CommandParameter="😂"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="18"
                    Padding="6,4"
                    Cursor="Hand" />
            <Button Content="😮"
                    Command="{Binding AddReactionCommand}"
                    CommandParameter="😮"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="18"
                    Padding="6,4"
                    Cursor="Hand" />
            <Button Content="😢"
                    Command="{Binding AddReactionCommand}"
                    CommandParameter="😢"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="18"
                    Padding="6,4"
                    Cursor="Hand" />
            <Button Content="🎉"
                    Command="{Binding AddReactionCommand}"
                    CommandParameter="🎉"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="18"
                    Padding="6,4"
                    Cursor="Hand" />
            <Button Content="🔥"
                    Command="{Binding AddReactionCommand}"
                    CommandParameter="🔥"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="18"
                    Padding="6,4"
                    Cursor="Hand" />
        </StackPanel>
    </Border>
</UserControl>
