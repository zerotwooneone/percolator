<!-- SPECIFICATION GOVERNANCE: Read Percolator.Desktop/spec/View.spec.md before modifying this file. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Percolator.Desktop.Features.Chats.ViewModels"
             x:Class="Percolator.Desktop.Features.Chats.Controls.ChatComposer"
             x:DataType="vm:ChatViewModel">

    <Border Background="{DynamicResource SurfaceSubtleBrush}"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="12,8">
        <Grid RowDefinitions="Auto,Auto">
            <!-- Pending Attachments Strip -->
            <ItemsControl Grid.Row="0"
                          ItemsSource="{Binding ComposerAttachments}"
                          Margin="0,0,0,8"
                          IsVisible="{Binding ComposerAttachments.Count}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="8,4"
                                Margin="0,0,6,4">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="📎" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding}" FontSize="12" VerticalAlignment="Center" />
                                <Button Content="✕"
                                        Classes="plain"
                                        FontSize="10"
                                        Padding="2"
                                        Command="{Binding ((vm:ChatViewModel)DataContext).RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        VerticalAlignment="Center"
                                        Cursor="Hand" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Main Input Bar -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto" VerticalAlignment="Center">
                <!-- Disappearing Timer Cycle Button -->
                <Button Grid.Column="0"
                        Command="{Binding CycleDisappearingTimerCommand}"
                        Classes="plain"
                        ToolTip.Tip="Disappearing Messages Timer"
                        Padding="8,6"
                        Margin="0,0,4,0"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="⏱" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ExpiringTimerLabel}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Send File Button -->
                <Button Grid.Column="1"
                        Command="{Binding SendFileCommand}"
                        Classes="plain"
                        ToolTip.Tip="Send File (Direct P2P)"
                        Padding="8,6"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        IsEnabled="{Binding !IsPendingOutbound}">
                    <TextBlock Text="📎" FontSize="14" VerticalAlignment="Center" />
                </Button>

                <!-- Composer Text Box -->
                <TextBox Grid.Column="2"
                         x:Name="ComposerInput"
                         Text="{Binding ComposerText, Mode=TwoWay}"
                         Watermark="Type a message... (Press Enter to send)"
                         AcceptsReturn="True"
                         MaxHeight="100"
                         Margin="0,0,8,0"
                         VerticalAlignment="Center"
                         CornerRadius="16"
                         Padding="12,8"
                         IsEnabled="{Binding !IsPendingOutbound}" />

                <!-- Send Button -->
                <Button Grid.Column="3"
                        Command="{Binding SendMessageCommand}"
                        Classes="accent"
                        ToolTip.Tip="Send Message"
                        CornerRadius="16"
                        Padding="14,8"
                        VerticalAlignment="Center">
                    <TextBlock Text="Send" FontWeight="SemiBold" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
