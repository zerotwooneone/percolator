<!-- SPECIFICATION GOVERNANCE: Read Percolator.Desktop/spec/View.spec.md before modifying this file. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Percolator.Desktop.Features.Chats.ViewModels"
             xmlns:m="using:Percolator.Desktop.Features.Chats.Models"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:controls="using:Percolator.Desktop.Common.Controls"
             x:Class="Percolator.Desktop.Features.Chats.Views.ChatsSidebarView"
             x:DataType="vm:ChatsSidebarViewModel">

    <Border Background="{DynamicResource LayerFillColorAltBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*">

            <!-- Section Header (e.g. "Direct Messages" or Relay Name) -->
            <Border Grid.Row="0"
                    Padding="{StaticResource CardPadding}"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                <TextBlock Text="{Binding HeaderTitle}"
                           Theme="{StaticResource SubtitleTextBlockStyle}"
                           TextTrimming="CharacterEllipsis" />
            </Border>

            <!-- Conversations List -->
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Conversations}"
                     SelectedItem="{Binding SelectedConversation, Mode=TwoWay}"
                     SelectionMode="Single"
                     Background="Transparent"
                     IsVisible="{Binding HasConversations}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="m:ConversationSummaryModel">
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4">
                            <!-- Avatar / Route indicator -->
                            <Border Grid.Column="0"
                                    Width="36" Height="36"
                                    CornerRadius="18"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,8,0">
                                <controls:NerdIcon GlyphType="DirectRoute"
                                                   FontSize="18"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                            </Border>

                            <!-- Name, Snippet & Pending status -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding DisplayName}"
                                               Theme="{StaticResource BodyStrongTextBlockStyle}"
                                               TextTrimming="CharacterEllipsis" />

                                    <!-- Pending pill -->
                                    <Border Grid.Column="1"
                                            Background="{DynamicResource SystemFillColorCautionBrush}"
                                            CornerRadius="4"
                                            Padding="4,1"
                                            Margin="4,0,0,0"
                                            IsVisible="{Binding IsPendingOutbound}">
                                        <TextBlock Text="Pending"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="Black" />
                                    </Border>
                                </Grid>

                                <TextBlock Text="{Binding LastMessageSnippet}"
                                           Theme="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Unread badge -->
                            <Border Grid.Column="2"
                                    Background="{DynamicResource SystemFillColorCriticalBrush}"
                                    CornerRadius="8"
                                    MinHeight="16" MinWidth="16"
                                    Padding="4,1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="4,0,0,0"
                                    IsVisible="{Binding HasUnread}">
                                <TextBlock Text="{Binding UnreadCount}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty State when no conversations -->
            <StackPanel Grid.Row="1"
                        Spacing="6"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="{StaticResource CardPadding}"
                        IsVisible="{Binding !HasConversations}">
                <controls:NerdIcon GlyphType="DirectRoute"
                                   FontSize="32"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="No conversations yet."
                           Theme="{StaticResource BodyStrongTextBlockStyle}"
                           TextAlignment="Center" />
                <TextBlock Text="Add a direct peer or select a relay to begin chatting."
                           Theme="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
