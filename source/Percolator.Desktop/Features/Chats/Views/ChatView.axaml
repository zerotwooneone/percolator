<!-- SPECIFICATION GOVERNANCE: Read Percolator.Desktop/spec/View.spec.md before modifying this file. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Percolator.Desktop.Features.Chats.ViewModels"
             xmlns:models="using:Percolator.Desktop.Features.Chats.Models"
             xmlns:controls="using:Percolator.Desktop.Features.Chats.Controls"
             x:Class="Percolator.Desktop.Features.Chats.Views.ChatView"
             x:DataType="vm:ChatViewModel">

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- 1. Conversation Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceSubtleBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ConversationTitle}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />

                    <!-- Route badge -->
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="8,2"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding RouteType}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </Border>
                </StackPanel>

                <!-- Disappearing message indicator in header -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="4"
                            VerticalAlignment="Center"
                            IsVisible="{Binding IsExpiringMessagesEnabled}">
                    <TextBlock Text="⏱" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ExpiringTimerLabel}"
                               FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Pending Connection Banner -->
        <Border Grid.Row="1"
                Background="#33FFC107"
                BorderBrush="#FFFFC107"
                BorderThickness="0,0,0,1"
                Padding="12,8"
                IsVisible="{Binding IsPendingOutbound}">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <TextBlock Text="⚠️" VerticalAlignment="Center" />
                <TextBlock Text="Waiting for peer to come online. Messages will be queued once connected."
                           Foreground="#FFFFD54F"
                           FontWeight="Medium"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 3. Message List Transcript -->
        <ListBox Grid.Row="2"
                 ItemsSource="{Binding Messages}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="16,12">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VerticalAlignment="Bottom" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ChatMessageViewModel">
                    <Grid Margin="0,4">
                        <!-- Outgoing Message Bubble (Right-aligned) -->
                        <StackPanel IsVisible="{Binding IsOutgoing}"
                                    HorizontalAlignment="Right"
                                    MaxWidth="500">
                            <Border Background="{DynamicResource AccentBrush}"
                                    CornerRadius="14,14,2,14"
                                    Padding="12,8">
                                <StackPanel Spacing="4">
                                    <!-- Attachments -->
                                    <ItemsControl ItemsSource="{Binding AttachmentFileNames}"
                                                  IsVisible="{Binding HasAttachments}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,4">
                                                    <TextBlock Text="📎" FontSize="11" Foreground="White" />
                                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="White" FontWeight="Medium" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Content / Tombstone -->
                                    <TextBlock Text="{Binding DisplayContent}"
                                               Foreground="White"
                                               TextWrapping="Wrap"
                                               FontStyle="{Binding IsTombstone, Converter={x:Static StringConverters.IsNullOrEmpty}}" />

                                    <!-- Metadata Row: Expiration countdown, timestamp, delivery ticks -->
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="6"
                                                HorizontalAlignment="Right"
                                                Opacity="0.8">
                                        <TextBlock Text="{Binding ExpirationRemainingText}"
                                                   FontSize="10"
                                                   Foreground="White"
                                                   IsVisible="{Binding ExpirationRemainingText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        <TextBlock Text="{Binding FormattedTime}"
                                                   FontSize="10"
                                                   Foreground="White" />
                                        <TextBlock Text="{Binding DeliveryStatus}"
                                                   FontSize="10"
                                                   Foreground="White" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Reactions & Actions Row -->
                            <StackPanel Orientation="Horizontal"
                                        Spacing="4"
                                        HorizontalAlignment="Right"
                                        Margin="0,2,0,0">
                                <!-- Reaction Chips -->
                                <ItemsControl ItemsSource="{Binding Reactions}"
                                              IsVisible="{Binding HasReactions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:ReactionGroupModel">
                                            <Button Command="{Binding ((vm:ChatMessageViewModel)DataContext).AddReactionCommand, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                    CommandParameter="{Binding Emoji.Value}"
                                                    Classes="plain"
                                                    Padding="4,2"
                                                    CornerRadius="10"
                                                    Background="{DynamicResource SurfaceSubtleBrush}">
                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                    <TextBlock Text="{Binding Emoji.Value}" FontSize="11" />
                                                    <TextBlock Text="{Binding Count}" FontSize="10" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Add Reaction Flyout Button -->
                                <Button Content="😀"
                                        Classes="plain"
                                        FontSize="12"
                                        Padding="3,1"
                                        ToolTip.Tip="Add Reaction">
                                    <Button.Flyout>
                                        <Flyout Placement="Top">
                                            <controls:ReactionPickerFlyout DataContext="{Binding}" />
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>

                                <!-- Delete button for outgoing messages -->
                                <Button Content="🗑"
                                        Command="{Binding DeleteMessageCommand}"
                                        Classes="plain"
                                        FontSize="11"
                                        Padding="3,1"
                                        ToolTip.Tip="Delete Message" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Incoming Message Bubble (Left-aligned) -->
                        <StackPanel IsVisible="{Binding !IsOutgoing}"
                                    HorizontalAlignment="Left"
                                    MaxWidth="500">
                            <!-- Sender Name -->
                            <TextBlock Text="{Binding AuthorDisplayName}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="4,0,0,2" />

                            <Border Background="{DynamicResource SurfaceSubtleBrush}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14,14,14,2"
                                    Padding="12,8">
                                <StackPanel Spacing="4">
                                    <!-- Attachments -->
                                    <ItemsControl ItemsSource="{Binding AttachmentFileNames}"
                                                  IsVisible="{Binding HasAttachments}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,4">
                                                    <TextBlock Text="📎" FontSize="11" />
                                                    <TextBlock Text="{Binding}" FontSize="12" FontWeight="Medium" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Content / Tombstone -->
                                    <TextBlock Text="{Binding DisplayContent}"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextWrapping="Wrap" />

                                    <!-- Metadata Row: Expiration countdown & timestamp -->
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="6"
                                                HorizontalAlignment="Right"
                                                Opacity="0.7">
                                        <TextBlock Text="{Binding ExpirationRemainingText}"
                                                   FontSize="10"
                                                   IsVisible="{Binding ExpirationRemainingText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        <TextBlock Text="{Binding FormattedTime}"
                                                   FontSize="10" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Reactions & Actions Row -->
                            <StackPanel Orientation="Horizontal"
                                        Spacing="4"
                                        HorizontalAlignment="Left"
                                        Margin="0,2,0,0">
                                <!-- Reaction Chips -->
                                <ItemsControl ItemsSource="{Binding Reactions}"
                                              IsVisible="{Binding HasReactions}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:ReactionGroupModel">
                                            <Button Command="{Binding ((vm:ChatMessageViewModel)DataContext).AddReactionCommand, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                    CommandParameter="{Binding Emoji.Value}"
                                                    Classes="plain"
                                                    Padding="4,2"
                                                    CornerRadius="10"
                                                    Background="{DynamicResource SurfaceSubtleBrush}">
                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                    <TextBlock Text="{Binding Emoji.Value}" FontSize="11" />
                                                    <TextBlock Text="{Binding Count}" FontSize="10" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Add Reaction Flyout Button -->
                                <Button Content="😀"
                                        Classes="plain"
                                        FontSize="12"
                                        Padding="3,1"
                                        ToolTip.Tip="Add Reaction">
                                    <Button.Flyout>
                                        <Flyout Placement="Top">
                                            <controls:ReactionPickerFlyout DataContext="{Binding}" />
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 4. Chat Composer -->
        <controls:ChatComposer Grid.Row="3" />
    </Grid>
</UserControl>
