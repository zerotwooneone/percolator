<!-- SPECIFICATION GOVERNANCE: Read Percolator.Desktop/spec/View.spec.md before modifying this file. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Percolator.Desktop.Features.Startup.ViewModels"
             xmlns:models="using:Percolator.Desktop.Features.Startup.Models"
             xmlns:sys="using:System"
             x:Class="Percolator.Desktop.Features.Startup.Views.IdentityGateView"
             x:DataType="vm:IdentityGateViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Margin="28,20">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Disable onboarding"
                          Command="{Binding DisableOnboardingCommand}"
                          IsVisible="{Binding IsOnboardingActive}" />
            </ContextMenu>
        </Grid.ContextMenu>
        <!-- Inline banner: port-conflict / recovery messaging. -->
        <Border Grid.Row="0"
                Classes="banner"
                Margin="0,0,0,12"
                IsVisible="{Binding HasBanner}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding BannerMessage}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1"
                        Classes="pill-edit"
                        Content="✕"
                        Command="{Binding DismissBannerCommand}"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel>
            <!-- State 2A: persona selection cards -->
            <DockPanel IsVisible="{Binding HasPersonas}">
                <TextBlock DockPanel.Dock="Top"
                           Text="Select personas to launch"
                           Theme="{StaticResource SubtitleTextBlockStyle}"
                           Margin="0,0,0,12" />
                <ItemsControl x:Name="PersonaItems" ItemsSource="{Binding Personas}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:SelectablePersonaModel">
                                <ToggleButton x:Name="PersonaCard"
                                              Classes="persona-toggle"
                                              IsChecked="{Binding IsSelected}"
                                              Margin="0,0,12,12">
                                    <ToggleButton.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Edit Profile"
                                                      Command="{Binding $parent[UserControl].((vm:IdentityGateViewModel)DataContext).EditPersonaCommand}"
                                                      CommandParameter="{Binding}" />
                                            <MenuItem Header="Delete Persona"
                                                      Command="{Binding $parent[UserControl].((vm:IdentityGateViewModel)DataContext).DeletePersonaCommand}"
                                                      CommandParameter="{Binding}" />
                                        </ContextMenu>
                                    </ToggleButton.ContextMenu>
                                    <Border Classes="persona-card" Width="248">
                                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                                            <Border Grid.RowSpan="2"
                                                    Classes="identicon-tile"
                                                    Width="48" Height="48"
                                                    Margin="0,0,12,0"
                                                    VerticalAlignment="Top">
                                                <ItemsControl DataContext="{Binding Avatar}"
                                                              ItemsSource="{Binding Cells}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="5" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="sys:Boolean">
                                                            <Border Margin="1"
                                                                    CornerRadius="1"
                                                                    IsVisible="{Binding .}"
                                                                    Background="{Binding $parent[ItemsControl].((models:AvatarPresentation)DataContext).Color}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>

                                            <Grid Grid.Column="1" Grid.Row="0" ColumnDefinitions="Auto,*">
                                                <CheckBox IsChecked="{Binding IsSelected}"
                                                          IsHitTestVisible="False"
                                                          VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DisplayName}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           Margin="4,0,0,0" />
                                            </Grid>

                                            <StackPanel Grid.Column="1" Grid.Row="1"
                                                        Orientation="Horizontal"
                                                        Spacing="4"
                                                        Margin="0,10,0,0">
                                                <Border Classes="port-pill"
                                                        Classes.ready="{Binding IsStatusReady}"
                                                        Classes.auto="{Binding IsStatusAutoSelected}"
                                                        Classes.busy="{Binding IsStatusUnavailable}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding PortPillText}"
                                                               FontSize="11" />
                                                </Border>
                                                <Button Classes="pill-edit"
                                                        Content="✎"
                                                        VerticalAlignment="Center">
                                                    <Button.Flyout>
                                                        <Flyout>
                                                            <StackPanel Spacing="8" MinWidth="180" Margin="12">
                                                                <TextBlock Text="Preferred port"
                                                                           Theme="{StaticResource CaptionTextBlockStyle}" />
                                                                <TextBox Text="{Binding PortEditorValue, Mode=TwoWay}" />
                                                                <Button Classes="accent"
                                                                        Content="Apply"
                                                                        Command="{Binding $parent[UserControl].((vm:IdentityGateViewModel)DataContext).ApplyPortOverrideCommand}"
                                                                        CommandParameter="{Binding}" />
                                                            </StackPanel>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
            </DockPanel>

            <!-- State 2B: empty-vault call to action -->
            <Grid IsVisible="{Binding HasEmptyState}">
                <Border Classes="persona-card"
                        Width="340"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel Spacing="12">
                        <TextBlock Text="No personas yet"
                                   Theme="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Tip: Many people create separate personas for Work vs. Personal, or Family vs. Friends."
                                   Theme="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <Button Classes="accent"
                                Content="Create Your First Persona"
                                Command="{Binding CreatePersonaCommand}"
                                HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Exchanges group — same tile-grid geometry, below Personas. The hollow `+`
                 tile is always present: ghosted while onboarding is active. -->
            <StackPanel Margin="0,20,0,0">
                <TextBlock Text="Exchanges"
                           Theme="{StaticResource SubtitleTextBlockStyle}"
                           Margin="0,0,0,12" />
                <WrapPanel>
                    <ItemsControl ItemsSource="{Binding Exchanges}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ExchangeTileViewModel">
                                <ToggleButton Classes="persona-toggle"
                                              IsChecked="{Binding IsSelectedForLaunch}"
                                              Margin="0,0,12,12">
                                    <Border Classes="persona-card"
                                            Classes.selfhosted="{Binding IsSelfHosted}"
                                            Width="248">
                                        <Grid RowDefinitions="Auto,Auto,Auto">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <Border Classes="identicon-tile"
                                                        Width="32" Height="32"
                                                        Margin="0,0,10,0"
                                                        VerticalAlignment="Center">
                                                    <ItemsControl DataContext="{Binding Avatar}"
                                                                  ItemsSource="{Binding Cells}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <UniformGrid Columns="5" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="sys:Boolean">
                                                                <Border Margin="1"
                                                                        CornerRadius="1"
                                                                        IsVisible="{Binding .}"
                                                                        Background="{Binding $parent[ItemsControl].((models:AvatarPresentation)DataContext).Color}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DisplayName}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <Button Grid.Column="2"
                                                        Classes="pill-edit"
                                                        Content="⚙"
                                                        VerticalAlignment="Center"
                                                        ToolTip.Tip="Manage exchange"
                                                        Command="{Binding $parent[UserControl].((vm:IdentityGateViewModel)DataContext).ManageExchangeCommand}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>

                                            <!-- Linkage strip: stacked persona avatar chips, +N overflow. -->
                                            <StackPanel Grid.Row="1"
                                                        Orientation="Horizontal"
                                                        Spacing="-14"
                                                        Margin="0,8,0,0"
                                                        IsVisible="{Binding HasLinkedPersonas}">
                                                <ItemsControl ItemsSource="{Binding VisibleLinkedPersonas}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:PersonaAvatarChip">
                                                            <Border Classes="identicon-tile"
                                                                    Width="24" Height="24"
                                                                    ToolTip.Tip="{Binding DisplayName}">
                                                                <ItemsControl DataContext="{Binding Avatar}"
                                                                              ItemsSource="{Binding Cells}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <UniformGrid Columns="5" />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="sys:Boolean">
                                                                            <Border Margin="1"
                                                                                    IsVisible="{Binding .}"
                                                                                    Background="{Binding $parent[ItemsControl].((models:AvatarPresentation)DataContext).Color}" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Border Classes="port-pill"
                                                        Padding="4,1"
                                                        VerticalAlignment="Center"
                                                        Margin="4,0,0,0"
                                                        IsVisible="{Binding HasLinkedOverflow}">
                                                    <TextBlock FontSize="10"
                                                               Text="{Binding OverflowLinkedPersonaCount, StringFormat='+{0}'}" />
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Grid.Row="2"
                                                        Orientation="Horizontal"
                                                        Spacing="4"
                                                        Margin="0,8,0,0">
                                                <Border Classes="port-pill"
                                                        Padding="6,1"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding IsSelfHosted}">
                                                    <TextBlock Text="self-hosted" FontSize="11" />
                                                </Border>
                                                <Border Classes="port-pill"
                                                        Classes.ready="{Binding IsStatusReady}"
                                                        Classes.auto="{Binding IsStatusAutoSelected}"
                                                        Classes.busy="{Binding IsStatusUnavailable}"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding IsSelfHosted}">
                                                    <TextBlock Text="{Binding PortPillText}"
                                                               FontSize="11" />
                                                </Border>
                                                <Border Classes="port-pill"
                                                        Padding="6,1"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding !IsSelfHosted}">
                                                    <TextBlock Text="remote" FontSize="11" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </ToggleButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Hollow `+` tile — visible but inert while onboarding is active. -->
                    <Button Width="120" Height="120"
                            Margin="0,0,12,12"
                            Classes.ghosted="{Binding IsOnboardingActive}"
                            IsEnabled="{Binding IsExchangeCreateEnabled}"
                            ToolTip.Tip="{Binding ExchangeCreateTooltip}"
                            Command="{Binding CreateExchangeCommand}">
                        <Button.Styles>
                            <Style Selector="Button.ghosted">
                                <Setter Property="Opacity" Value="0.45" />
                            </Style>
                        </Button.Styles>
                        <TextBlock Text="+"
                                   FontSize="36"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Button>
                </WrapPanel>
            </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer: single-persona auto-start flag + launch -->
        <Grid Grid.Row="2"
              ColumnDefinitions="*,Auto,Auto"
              Margin="0,16,0,0"
              IsVisible="{Binding HasPersonas}">
            <CheckBox Grid.Column="0"
                      Content="Always auto-start with this persona on unlock"
                      IsChecked="{Binding AutoStartRequested}"
                      IsEnabled="{Binding IsAutoStartApplicable}"
                      VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Content="+ New Persona"
                    Command="{Binding CreatePersonaCommand}"
                    VerticalAlignment="Center"
                    Margin="12,0,12,0" />
            <Button Grid.Column="2"
                    Classes="accent"
                    Content="Launch Selected Personas →"
                    Command="{Binding LaunchPersonasCommand}"
                    VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
