<!-- SPECIFICATION GOVERNANCE: Read Percolator.Desktop/spec/View.spec.md before modifying this file. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Percolator.Desktop.Features.Startup.ViewModels"
        xmlns:models="using:Percolator.Desktop.Features.Startup.Models"
        xmlns:sys="using:System"
        x:Class="Percolator.Desktop.Features.Startup.Views.ExchangeCreationWindow"
        x:DataType="vm:ExchangeCreationViewModel"
        Title="New Exchange"
        Width="460"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <StackPanel Margin="24" Spacing="16">
        <TextBlock Text="{Binding CurrentStepLabel}"
                   Theme="{StaticResource SubtitleTextBlockStyle}" />

        <!-- Step 1: advanced-feature framing + honest uptime warning. -->
        <StackPanel IsVisible="{Binding IsFramingStep}" Spacing="12">
            <Border Classes="banner" Padding="12">
                <TextBlock Text="{Binding FramingMessage}"
                           TextWrapping="Wrap" />
            </Border>
            <TextBlock Text="An exchange is a post-office for offline personas: it holds sealed envelopes and hands them back when a persona comes online. Running your own is optional — most users never need it."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Button Content="Or add an existing exchange someone else runs →"
                    Command="{Binding UseRemoteCommand}"
                    HorizontalAlignment="Left" />
        </StackPanel>

        <!-- Remote registration: endpoint + relay identity shared out-of-band. A pure
             vault-local row write — no connection is opened from the gate. -->
        <StackPanel IsVisible="{Binding IsRemoteStep}" Spacing="12">
            <TextBlock Text="Adding an exchange records it in your vault — nothing is sent. The exchange operator shares its relay identity and address out-of-band."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="Exchange address (host:port or URI)"
                       Theme="{StaticResource CaptionTextBlockStyle}" />
            <TextBox Text="{Binding RemoteEndpoint, Mode=TwoWay}" />
            <TextBlock Text="Relay identity (GUID)"
                       Theme="{StaticResource CaptionTextBlockStyle}" />
            <TextBox Text="{Binding RemoteRelayId, Mode=TwoWay}" />
            <Border Classes="banner"
                    Padding="8"
                    IsVisible="{Binding RemoteError, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="{Binding RemoteError}"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <!-- Step 2: display name + avatar + preferred port (mirrors persona creation). -->
        <StackPanel IsVisible="{Binding IsProfileStep}" Spacing="12">
            <Grid ColumnDefinitions="Auto,*">
                <Border Classes="identicon-tile"
                        Width="48" Height="48"
                        Margin="0,0,12,0"
                        VerticalAlignment="Top">
                    <ItemsControl DataContext="{Binding Avatar}"
                                  ItemsSource="{Binding Cells}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="5" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="sys:Boolean">
                                <Border Margin="1"
                                        CornerRadius="1"
                                        IsVisible="{Binding .}"
                                        Background="{Binding $parent[ItemsControl].((models:AvatarPresentation)DataContext).Color}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <StackPanel Grid.Column="1" Spacing="8">
                    <TextBox Watermark="Exchange name"
                             Text="{Binding DisplayName, Mode=TwoWay}" />
                    <Button Content="Re-roll avatar"
                            Command="{Binding RerollAvatarCommand}"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </Grid>
            <TextBlock Text="Preferred port"
                       Theme="{StaticResource CaptionTextBlockStyle}" />
            <TextBox Text="{Binding PreferredPort, Mode=TwoWay}" />
        </StackPanel>

        <!-- Step 3: optional persona linking — every checkbox ships unchecked. -->
        <StackPanel IsVisible="{Binding IsLinkingStep}" Spacing="12">
            <TextBlock Text="{Binding LinkingMessage}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ScrollViewer MaxHeight="220">
                <ItemsControl ItemsSource="{Binding LinkablePersonas}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:LinkablePersonaModel">
                            <CheckBox IsChecked="{Binding IsLinked}"
                                      Margin="0,4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Classes="identicon-tile" Width="20" Height="20">
                                        <ItemsControl DataContext="{Binding Avatar}"
                                                      ItemsSource="{Binding Cells}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="5" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="sys:Boolean">
                                                    <Border Margin="1"
                                                            IsVisible="{Binding .}"
                                                            Background="{Binding $parent[ItemsControl].((models:AvatarPresentation)DataContext).Color}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                    <TextBlock Text="{Binding DisplayName}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>

        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
            <Button Content="Back"
                    Command="{Binding BackCommand}"
                    IsVisible="{Binding !IsFramingStep}" />
            <Button Grid.Column="2"
                    Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Margin="0,0,8,0" />
            <Button Grid.Column="3"
                    Content="Next"
                    Command="{Binding NextCommand}"
                    IsVisible="{Binding ShowNext}"
                    Margin="0,0,8,0" />
            <Button Grid.Column="4"
                    Classes="accent"
                    Content="Create Exchange"
                    Command="{Binding FinishCommand}"
                    IsVisible="{Binding !IsFramingStep}" />
        </Grid>
    </StackPanel>
</Window>
