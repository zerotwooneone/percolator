<!-- SPECIFICATION GOVERNANCE: Read Percolator.Desktop/spec/View.spec.md before modifying this file. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:Percolator.Desktop.Features.Startup.ViewModels"
             x:Class="Percolator.Desktop.Features.Startup.Views.VaultUnlockView"
             x:DataType="vm:VaultUnlockViewModel">

    <Grid RowDefinitions="*,Auto" Margin="32,28">
        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="Percolator"
                       Theme="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Unlock Vault"
                       Theme="{StaticResource SubtitleTextBlockStyle}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <Border x:Name="ShakeTarget"
                    Margin="0,24,0,0"
                    RenderTransform="translate(0,0)">
                <TextBox x:Name="PasswordInput"
                         Watermark="Master password"
                         PasswordChar="•"
                         Text="{Binding Password, Mode=TwoWay}" />
            </Border>

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       TextWrapping="Wrap"
                       IsVisible="{Binding !!ErrorMessage}" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
            <Button Grid.Column="0"
                    Content="Unlock"
                    Command="{Binding UnlockCommand}"
                    IsEnabled="{Binding !IsBusy}"
                    HorizontalAlignment="Stretch" />
            <!-- Inline spinner during Argon2id key derivation -->
            <ui:ProgressRing Grid.Column="1"
                             Margin="8,0,0,0"
                             Width="28" Height="28"
                             IsIndeterminate="{Binding IsBusy}"
                             IsVisible="{Binding IsBusy}" />
        </Grid>
    </Grid>
</UserControl>
