<!-- SPECIFICATION GOVERNANCE: Read Percolator.Desktop/spec/Style.spec.md before modifying this file. -->
<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             xmlns:local="using:Percolator.Desktop"
             x:Class="Percolator.Desktop.App"
             RequestedThemeVariant="Default">
    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Percolator.Desktop/Common/Styles/Spacing.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Embedded Nerd Font for P2P mesh & route telemetry iconography -->
            <FontFamily x:Key="NerdFontFamily">avares://Percolator.Desktop/Assets/Fonts#FiraCode Nerd Font Mono</FontFamily>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <!-- Sole theme engine ([STYLE-003]): FluentAvalonia Fluent v2 theme, no FluentTheme/SimpleTheme mixing -->
        <sty:FluentAvaloniaTheme PreferUserAccentColor="True" PreferSystemTheme="True" />
        <StyleInclude Source="avares://Percolator.Desktop/Common/Styles/CustomStyles.axaml" />
    </Application.Styles>
</Application>
