<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Percolator.Simulator.Features.Scenarios"
             xmlns:model="using:Percolator.Simulator.Features.Scenarios.Model"
             x:Class="Percolator.Simulator.Features.Scenarios.FlightRecorderView"
             x:DataType="vm:FlightRecorderViewModel">

    <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0"
            Width="260"
            Padding="8">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
            <!-- Header & CTL-REC-01 -->
            <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,8">
                <TextBlock Text="FLIGHT RECORDER" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <Grid ColumnDefinitions="*,Auto">
                    <Button Grid.Column="0"
                            Content="{Binding RecordButtonLabel}"
                            Command="{Binding ToggleRecordCommand}"
                            HorizontalAlignment="Stretch" />
                    <Button Grid.Column="1" Content="🗑️" Command="{Binding ClearStepsCommand}" Margin="4,0,0,0" ToolTip.Tip="Clear Steps" />
                </Grid>
                <TextBlock IsVisible="{Binding IsRecording}" Text="● RECORDING ACTIVE" Foreground="#E53935" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Replay Status Banner -->
            <Border Grid.Row="1"
                    Background="#1E3A8A"
                    CornerRadius="4"
                    Padding="6,4"
                    Margin="0,0,0,6"
                    IsVisible="{Binding ActiveReplayStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding ActiveReplayStatus}" Foreground="White" FontSize="10" TextWrapping="Wrap" />
            </Border>

            <!-- Steps List -->
            <Border Grid.Row="2" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="6">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding RecordedSteps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="model:ScenarioStepDefinition">
                                <Border Background="#1AFFFFFF" CornerRadius="4" Padding="6,4" Margin="0,2">
                                    <TextBlock Text="{Binding DisplayText}" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- CTL-REC-02: Save & Load -->
            <StackPanel Grid.Row="3" Spacing="4" Margin="0,8,0,0">
                <Button Content="💾 Save Scenario..." Command="{Binding SaveScenarioCommand}" HorizontalAlignment="Stretch" />
                <Button Content="📂 Load &amp; Replay..." Command="{Binding LoadReplayCommand}" HorizontalAlignment="Stretch" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
