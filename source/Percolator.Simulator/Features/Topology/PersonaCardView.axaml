<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Percolator.Simulator.Features.Topology"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="550"
             x:Class="Percolator.Simulator.Features.Topology.PersonaCardView"
             x:DataType="vm:PersonaCardViewModel">

    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14"
            Margin="6">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
            <!-- Header CTL-PER-01, 02 -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="6" ClipToBounds="True" Background="#333333" Margin="0,0,10,0">
                    <Image Source="{Binding IdenticonBitmap}" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="14" />
                    <TextBlock Text="{Binding BoundEndpoint}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Content="🎲" ToolTip.Tip="Reroll Profile (CTL-PER-01)" Command="{Binding RerollProfileCommand}" Padding="6,4" />
                    <ToggleButton Content="🟢" IsChecked="{Binding IsListening}" ToolTip.Tip="Toggle Ingress (Listening/Muted) (CTL-PER-02)" Padding="6,4" />
                </StackPanel>
            </Grid>

            <!-- Toggles & Action Toolbar CTL-PER-03..12 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,0,0,10">
                <!-- Dropdown for Capabilities -->
                <DropDownButton Content="⚙️ Capabilities ▼">
                    <DropDownButton.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Spacing="6" MinWidth="200" Margin="4">
                                <TextBlock Text="Protocol Capabilities" FontWeight="Bold" FontSize="11" />
                                <CheckBox Content="Allow Peer Discovery (CTL-PER-03)" IsChecked="{Binding AllowPeerDiscovery}" />
                                <CheckBox Content="Allow File Transfers (CTL-PER-04)" IsChecked="{Binding AllowFileTransfers}" />
                                <CheckBox Content="Send Read Receipts (CTL-PER-05)" IsChecked="{Binding SendReadReceipts}" />
                                <CheckBox Content="Relay-Only Routing (CTL-PER-06)" IsChecked="{Binding RelayOnlyRouting}" />
                            </StackPanel>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <!-- Dropdown for Autopilot -->
                <DropDownButton Content="🤖 Autopilot ▼">
                    <DropDownButton.Flyout>
                        <Flyout Placement="Bottom">
                            <StackPanel Spacing="6" MinWidth="200" Margin="4">
                                <TextBlock Text="Automated Bot Responses" FontWeight="Bold" FontSize="11" />
                                <CheckBox Content="Auto-Accept Handshakes" IsChecked="{Binding AutoAcceptHandshakes}" />
                                <CheckBox Content="Auto-Reply 'Pong'" IsChecked="{Binding AutoReplyPong}" />
                                <CheckBox Content="Auto-Replenish PreKeys" IsChecked="{Binding AutoReplenishPreKeys}" />
                                <CheckBox Content="Auto-Share Profile on Connect" IsChecked="{Binding AutoShareProfile}" />
                                <CheckBox Content="Auto-Accept Group Invites" IsChecked="{Binding AutoAcceptGroupInvites}" />
                                <CheckBox Content="Auto-Accept File Transfers" IsChecked="{Binding AutoAcceptFileTransfers}" />
                            </StackPanel>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>

                <!-- CTL-PER-13: Relay Bar -->
                <Button Content="📬 Register Relay" Command="{Binding RegisterRelayCommand}" />
                <Button Content="🔑 Publish PreKeys" Command="{Binding PublishPreKeysCommand}" />
            </StackPanel>

            <!-- Pending Banner CTL-PER-14 -->
            <Border Grid.Row="2" Background="#263859" CornerRadius="6" Padding="8,6" Margin="0,0,0,8"
                    IsVisible="{Binding HasPendingHandshake}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding PendingHandshakeText}" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <Button Content="✓ Accept" Command="{Binding AcceptPendingHandshakeCommand}" Classes="accent" Padding="6,2" />
                        <Button Content="✕ Reject" Command="{Binding RejectPendingHandshakeCommand}" Padding="6,2" />
                        <Button Content="🚫 Block" Command="{Binding BlockPendingHandshakeCommand}" Padding="6,2" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Chat Tab Transcript CTL-PER-17, 18, 20 -->
            <Border Grid.Row="3" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="8">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding ChatMessages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        CornerRadius="4" Padding="6,4" Margin="0,2">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding BodyText}" FontSize="12" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Text="{Binding StatusText}"
                                                   Foreground="{Binding StatusColor}"
                                                   ToolTip.Tip="{Binding StatusTooltip}"
                                                   FontWeight="Bold" FontSize="12"
                                                   Margin="6,0,0,0" VerticalAlignment="Bottom"
                                                   IsVisible="{Binding IsOutgoing}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Compose Bar CTL-PER-18, 19 -->
            <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
                <ComboBox Grid.Column="0" SelectedIndex="0" Margin="0,0,6,0">
                    <ComboBoxItem Content="Timer: Off" />
                    <ComboBoxItem Content="Timer: 1m" />
                    <ComboBoxItem Content="Timer: 1h" />
                </ComboBox>
                <TextBox Grid.Column="1"
                         Text="{Binding ComposeMessageText}"
                         Watermark="Type a message (CTL-PER-18)..." />
                <Button Grid.Column="2"
                        Content="Send"
                        Command="{Binding SendMessageCommand}"
                        Classes="accent"
                        Margin="6,0,0,0" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
