<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Percolator.Simulator.Features.GroupMessaging"
             mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="550"
             x:Class="Percolator.Simulator.Features.GroupMessaging.GroupPanelView"
             x:DataType="vm:GroupPanelViewModel"
             x:Name="GroupPanelRoot">

    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="14"
            Margin="6">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
            <!-- Header CTL-GRP-01 -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="6" ClipToBounds="True" Background="#4A154B" Margin="0,0,10,0">
                    <TextBlock Text="👥" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding GroupName}" FontWeight="Bold" FontSize="14" />
                    <TextBlock Text="{Binding RelayEndpoint}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Border Grid.Column="2" Background="#263859" CornerRadius="4" Padding="6,4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentEpoch, StringFormat='Epoch {0}'}"
                               FontWeight="Bold" FontSize="11" Foreground="#4CC2FF" />
                </Border>
            </Grid>

            <!-- Actions Bar: Rename, Flood, Add Member CTL-GRP-01, CTL-GRP-02 -->
            <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,10">
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,2">
                    <TextBox Grid.Column="0"
                             Text="{Binding NewGroupName}"
                             Watermark="New group name..."
                             Margin="0,0,6,0" />
                    <Button Grid.Column="1"
                            Content="✏️ Rename"
                            Command="{Binding RenameGroupCommand}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto,Auto">
                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding Candidates}"
                              SelectedItem="{Binding SelectedCandidate}"
                              HorizontalAlignment="Stretch"
                              Margin="0,0,6,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" FontSize="12" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="1"
                            Content="+ Add Member"
                            Command="{Binding AddMemberCommand}"
                            Margin="0,0,6,0" />
                    <Button Grid.Column="2"
                            Content="🌊 Flood 25"
                            ToolTip.Tip="Flood 25 Messages (CTL-GRP-02)"
                            Command="{Binding FloodMessagesCommand}"
                            Classes="accent" />
                </Grid>
            </StackPanel>

            <!-- Group Roster Members List CTL-GRP-01 -->
            <Border Grid.Row="2" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="8">
                <Grid RowDefinitions="Auto,*">
                    <TextBlock Grid.Row="0" Text="Group Members &amp; ZK Presentation Proofs"
                               FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding Members}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:GroupMemberItemViewModel">
                                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            CornerRadius="4" Padding="8,6" Margin="0,2">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding RoleBadge}"
                                                       FontWeight="Bold" FontSize="11"
                                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DisplayName}"
                                                       FontWeight="SemiBold" FontSize="12"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="2"
                                                    Content="✕ Evict"
                                                    ToolTip.Tip="Evict Member &amp; Advance Epoch (Forward Secrecy)"
                                                    Command="{Binding #GroupPanelRoot.DataContext.EvictMemberCommand}"
                                                    CommandParameter="{Binding}"
                                                    IsVisible="{Binding CanEvict}"
                                                    Foreground="#FF6B6B"
                                                    Padding="6,2" FontSize="11" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
