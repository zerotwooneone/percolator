<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Percolator.Simulator.Features.Logging"
             x:Class="Percolator.Simulator.Features.Logging.LogDockView"
             x:DataType="vm:LogDockViewModel">

    <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Height="140"
            Padding="8,6">
        <Grid RowDefinitions="Auto,*">
            <!-- Header with Level Filter CTL-LOG-01 and Clear CTL-LOG-02 -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,4">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="LOG VIEWER" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <!-- CTL-LOG-01 -->
                    <ComboBox SelectedIndex="{Binding SelectedLogLevelIndex}" Height="24" Padding="6,2">
                        <ComboBoxItem Content="Trace" />
                        <ComboBoxItem Content="Debug" />
                        <ComboBoxItem Content="Information" />
                        <ComboBoxItem Content="Warning" />
                        <ComboBoxItem Content="Error" />
                    </ComboBox>
                </StackPanel>

                <!-- CTL-LOG-02: Clear UI Log -->
                <Button Grid.Column="2" Content="🧹 Clear UI Log" Command="{Binding ClearLogCommand}" Padding="6,2" />
            </Grid>

            <!-- Bounded Ring Buffer Display -->
            <Border Grid.Row="1" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="4" Padding="6">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding LogEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="11" FontFamily="Consolas" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</UserControl>
