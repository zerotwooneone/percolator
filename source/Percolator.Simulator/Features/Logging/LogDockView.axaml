<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Percolator.Simulator.Features.Logging"
             xmlns:logging="using:Percolator.Simulator.Features.Logging"
             x:Class="Percolator.Simulator.Features.Logging.LogDockView"
             x:DataType="vm:LogDockViewModel">

    <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Height="160"
            Padding="8,6">
        <Grid RowDefinitions="Auto,*">
            <!-- Header with Level Filter CTL-LOG-01, Copy All, and Clear CTL-LOG-02 -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,4">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="LOG VIEWER" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <!-- CTL-LOG-01: Minimum Log Level -->
                    <ComboBox SelectedIndex="{Binding SelectedLogLevelIndex}" Height="24" Padding="6,2">
                        <ComboBoxItem Content="Trace" />
                        <ComboBoxItem Content="Debug" />
                        <ComboBoxItem Content="Information" />
                        <ComboBoxItem Content="Warning" />
                        <ComboBoxItem Content="Error" />
                    </ComboBox>
                </StackPanel>

                <!-- Actions: Copy All and Clear -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                    <Button Content="📋 Copy All"
                            Command="{Binding CopyAllLogsCommand}"
                            ToolTip.Tip="Copy all visible log lines to clipboard"
                            Padding="8,2" />
                    <!-- CTL-LOG-02: Clear UI Log -->
                    <Button Content="🧹 Clear UI Log"
                            Command="{Binding ClearLogCommand}"
                            Padding="8,2" />
                </StackPanel>
            </Grid>

            <!-- Bounded Ring Buffer Display -->
            <Border Grid.Row="1" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="4" Padding="6">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="📋 Copy All Logs" Command="{Binding CopyAllLogsCommand}" />
                        <Separator />
                        <MenuItem Header="🧹 Clear UI Log" Command="{Binding ClearLogCommand}" />
                    </ContextMenu>
                </Border.ContextMenu>
                <ScrollViewer x:Name="LogScrollViewer">
                    <ItemsControl ItemsSource="{Binding LogEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="logging:UiLogItem">
                                <Grid ColumnDefinitions="Auto,*" Margin="0,1" Background="Transparent">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="📋 Copy Log Line"
                                                      Command="{Binding CopyLineCommand}" />
                                            <MenuItem Header="📄 Copy Message Only"
                                                      Command="{Binding CopyMessageCommand}" />
                                            <Separator />
                                            <MenuItem Header="📑 Copy All Logs"
                                                      Command="{Binding CopyAllLogsCommand}" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>

                                    <Border Grid.Column="0" Background="{Binding BadgeColor}" CornerRadius="3" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding Level}" FontSize="9" FontWeight="Bold" Foreground="White" />
                                    </Border>
                                    <SelectableTextBlock Grid.Column="1"
                                                         Text="{Binding FormattedText}"
                                                         FontSize="11"
                                                         FontFamily="Consolas,Monospace"
                                                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                         VerticalAlignment="Center"
                                                         TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</UserControl>
