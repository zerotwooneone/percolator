<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Percolator.Simulator.Features.Logging"
             x:Class="Percolator.Simulator.Features.Logging.LogDockView"
             x:DataType="vm:LogDockViewModel">

    <Border Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Height="160"
            Padding="8,6">
        <Grid RowDefinitions="Auto,*">
            <!-- Header with Level Filter CTL-LOG-01, Copy All, and Clear CTL-LOG-02 -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,4">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="LOG VIEWER" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <!-- CTL-LOG-01: Minimum Log Level -->
                    <ComboBox SelectedIndex="{Binding SelectedLogLevelIndex}" Height="24" Padding="6,2">
                        <ComboBoxItem Content="Trace" />
                        <ComboBoxItem Content="Debug" />
                        <ComboBoxItem Content="Information" />
                        <ComboBoxItem Content="Warning" />
                        <ComboBoxItem Content="Error" />
                    </ComboBox>
                </StackPanel>

                <!-- Actions: Copy All and Clear -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                    <Button Content="📋 Copy All"
                            Command="{Binding CopyAllLogsCommand}"
                            ToolTip.Tip="Copy all visible logs to clipboard (or drag inside the text box to copy any group of lines)"
                            Padding="8,2" />
                    <!-- CTL-LOG-02: Clear UI Log -->
                    <Button Content="🧹 Clear UI Log"
                            Command="{Binding ClearLogCommand}"
                            Padding="8,2" />
                </StackPanel>
            </Grid>

            <!-- Unified Multi-Line Read-Only Log Buffer -->
            <TextBox Grid.Row="1"
                     x:Name="LogTextBox"
                     Text="{Binding LogText, Mode=OneWay}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     FontFamily="Consolas,Cascadia Code,Monospace"
                     FontSize="11"
                     Background="{DynamicResource ControlFillColorDefaultBrush}"
                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                     BorderThickness="1"
                     BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                     CornerRadius="4"
                     Padding="8,6"
                     TextWrapping="NoWrap"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </Grid>
    </Border>
</UserControl>
